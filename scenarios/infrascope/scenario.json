{
  "id": "infrascope",
  "version": "0.5.0",
  "name": "Infrascope",
  "type": "desktop",
  "title": "Infrascope",
  "description": "Operator control-plane scenario for overview, inventory, and in-context object inspection.",
  "depends": [
    "infrascope_skill"
  ],
  "ui": {
    "application": {
      "version": "0.1",
      "desktop": {
        "pageSchema": {
          "id": "infrascope",
          "title": "Infrascope",
          "layout": {
            "type": "split",
            "pattern": "split",
            "areas": [
              {
                "id": "sidebar",
                "role": "sidebar"
              },
              {
                "id": "main",
                "role": "main"
              },
              {
                "id": "right",
                "role": "aux"
              }
            ]
          },
          "initialState": {
            "infrascopeMode": "overview",
            "inventoryKind": "all",
            "inspectorTab": "summary",
            "selectedObjectId": "local"
          },
          "widgets": [
            {
              "id": "infrascope-mode",
              "type": "input.commandBar",
              "area": "sidebar",
              "title": "Mode",
              "inputs": {
                "selectedStateKey": "infrascopeMode",
                "buttons": [
                  {
                    "id": "overview",
                    "label": "Overview"
                  },
                  {
                    "id": "inventory",
                    "label": "Inventory"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:overview",
                  "type": "updateState",
                  "params": {
                    "infrascopeMode": "overview"
                  }
                },
                {
                  "on": "click:inventory",
                  "type": "updateState",
                  "params": {
                    "infrascopeMode": "inventory"
                  }
                }
              ]
            },
            {
              "id": "infrascope-inventory-tabs",
              "type": "input.commandBar",
              "area": "sidebar",
              "title": "Inventory",
              "visibleIf": "$state.infrascopeMode === 'inventory'",
              "inputs": {
                "size": "small",
                "selectedStateKey": "inventoryKind",
                "buttons": [
                  {
                    "id": "all",
                    "label": "All"
                  },
                  {
                    "id": "hubs",
                    "label": "Hubs"
                  },
                  {
                    "id": "members",
                    "label": "Members"
                  },
                  {
                    "id": "browsers",
                    "label": "Browsers"
                  },
                  {
                    "id": "devices",
                    "label": "Devices"
                  },
                  {
                    "id": "skills",
                    "label": "Skills"
                  },
                  {
                    "id": "scenarios",
                    "label": "Scenarios"
                  },
                  {
                    "id": "runtimes",
                    "label": "Runtimes"
                  },
                  {
                    "id": "quotas",
                    "label": "Quotas"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:all",
                  "type": "updateState",
                  "params": {
                    "inventoryKind": "all"
                  }
                },
                {
                  "on": "click:hubs",
                  "type": "updateState",
                  "params": {
                    "inventoryKind": "hubs"
                  }
                },
                {
                  "on": "click:members",
                  "type": "updateState",
                  "params": {
                    "inventoryKind": "members"
                  }
                },
                {
                  "on": "click:browsers",
                  "type": "updateState",
                  "params": {
                    "inventoryKind": "browsers"
                  }
                },
                {
                  "on": "click:devices",
                  "type": "updateState",
                  "params": {
                    "inventoryKind": "devices"
                  }
                },
                {
                  "on": "click:skills",
                  "type": "updateState",
                  "params": {
                    "inventoryKind": "skills"
                  }
                },
                {
                  "on": "click:scenarios",
                  "type": "updateState",
                  "params": {
                    "inventoryKind": "scenarios"
                  }
                },
                {
                  "on": "click:runtimes",
                  "type": "updateState",
                  "params": {
                    "inventoryKind": "runtimes"
                  }
                },
                {
                  "on": "click:quotas",
                  "type": "updateState",
                  "params": {
                    "inventoryKind": "quotas"
                  }
                }
              ]
            },
            {
              "id": "inventory-list",
              "type": "ui.list",
              "area": "sidebar",
              "title": "Objects",
              "visibleIf": "$state.infrascopeMode === 'inventory'",
              "dataSource": {
                "kind": "stream",
                "receiver": "infrascope.inventory.$state.inventoryKind"
              },
              "inputs": {
                "emptyText": "No objects available",
                "inset": true,
                "titleKey": "title",
                "subtitleKey": "subtitle",
                "iconKey": "icon",
                "itemAccordion": false,
                "detailsPath": "",
                "detailsModal": true,
                "detailsModalTitleKey": "title",
                "detailsDataSource": {
                  "kind": "stream",
                  "receiver": "infrascope.inspector.$event.object_id"
                }
              },
              "actions": [
                {
                  "on": "select",
                  "type": "updateState",
                  "params": {
                    "selectedObjectId": "$event.object_id",
                    "inspectorTab": "summary"
                  }
                }
              ]
            },
            {
              "id": "overview-summary",
              "type": "item.details",
              "area": "main",
              "title": "Overview summary",
              "visibleIf": "$state.infrascopeMode === 'overview'",
              "dataSource": {
                "kind": "y",
                "path": "data/infrascope/summary"
              }
            },
            {
              "id": "overview-health-strip",
              "type": "ui.list",
              "area": "main",
              "title": "Health strip",
              "visibleIf": "$state.infrascopeMode === 'overview'",
              "dataSource": {
                "kind": "stream",
                "receiver": "infrascope.overview.health_strip"
              },
              "inputs": {
                "emptyText": "No health signals",
                "inset": true,
                "titleKey": "title",
                "subtitleKey": "subtitle",
                "iconKey": "icon",
                "itemAccordion": false,
                "detailsPath": "",
                "detailsModal": true,
                "detailsModalTitleKey": "title",
                "detailsDataSource": {
                  "kind": "stream",
                  "receiver": "infrascope.inspector.$event.object_id"
                }
              },
              "actions": [
                {
                  "on": "select",
                  "type": "updateState",
                  "params": {
                    "selectedObjectId": "$event.object_id",
                    "inspectorTab": "summary"
                  }
                }
              ]
            },
            {
              "id": "overview-incidents",
              "type": "ui.list",
              "area": "main",
              "title": "Active incidents",
              "visibleIf": "$state.infrascopeMode === 'overview'",
              "dataSource": {
                "kind": "stream",
                "receiver": "infrascope.overview.active_incidents"
              },
              "inputs": {
                "emptyText": "No active incidents",
                "inset": true,
                "titleKey": "title",
                "subtitleKey": "subtitle",
                "iconKey": "icon",
                "itemAccordion": false,
                "detailsPath": "",
                "detailsModal": true,
                "detailsModalTitleKey": "title",
                "detailsDataSource": {
                  "kind": "stream",
                  "receiver": "infrascope.inspector.$event.object_id"
                }
              },
              "actions": [
                {
                  "on": "select",
                  "type": "updateState",
                  "params": {
                    "selectedObjectId": "$event.object_id",
                    "inspectorTab": "incidents"
                  }
                }
              ]
            },
            {
              "id": "overview-operations",
              "type": "ui.list",
              "area": "main",
              "title": "Operations",
              "visibleIf": "$state.infrascopeMode === 'overview'",
              "dataSource": {
                "kind": "stream",
                "receiver": "infrascope.operations.active"
              },
              "inputs": {
                "emptyText": "No active operations",
                "inset": true,
                "titleKey": "title",
                "subtitleKey": "subtitle",
                "iconKey": "icon",
                "itemAccordion": true,
                "detailsPath": "details",
                "detailsModal": true,
                "detailsModalTitleKey": "title"
              }
            },
            {
              "id": "inspector-tabs",
              "type": "input.commandBar",
              "area": "right",
              "title": "Inspector",
              "inputs": {
                "size": "small",
                "selectedStateKey": "inspectorTab",
                "buttons": [
                  {
                    "id": "summary",
                    "label": "Summary"
                  },
                  {
                    "id": "incidents",
                    "label": "Incidents"
                  },
                  {
                    "id": "topology",
                    "label": "Topology"
                  },
                  {
                    "id": "task",
                    "label": "Task"
                  },
                  {
                    "id": "planning",
                    "label": "Planning"
                  },
                  {
                    "id": "actions",
                    "label": "Actions"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:summary",
                  "type": "updateState",
                  "params": {
                    "inspectorTab": "summary"
                  }
                },
                {
                  "on": "click:incidents",
                  "type": "updateState",
                  "params": {
                    "inspectorTab": "incidents"
                  }
                },
                {
                  "on": "click:topology",
                  "type": "updateState",
                  "params": {
                    "inspectorTab": "topology"
                  }
                },
                {
                  "on": "click:task",
                  "type": "updateState",
                  "params": {
                    "inspectorTab": "task"
                  }
                },
                {
                  "on": "click:planning",
                  "type": "updateState",
                  "params": {
                    "inspectorTab": "planning"
                  }
                },
                {
                  "on": "click:actions",
                  "type": "updateState",
                  "params": {
                    "inspectorTab": "actions"
                  }
                }
              ]
            },
            {
              "id": "selected-object-summary",
              "type": "item.details",
              "area": "right",
              "title": "Selected object",
              "visibleIf": "$state.inspectorTab === 'summary'",
              "dataSource": {
                "kind": "stream",
                "receiver": "infrascope.inspector.$state.selectedObjectId"
              }
            },
            {
              "id": "selected-object-incidents",
              "type": "ui.list",
              "area": "right",
              "title": "Object incidents",
              "visibleIf": "$state.inspectorTab === 'incidents'",
              "dataSource": {
                "kind": "stream",
                "receiver": "infrascope.inspector_field.incidents.$state.selectedObjectId"
              },
              "inputs": {
                "emptyText": "No incidents on this object",
                "inset": true,
                "titleKey": "title",
                "subtitleKey": "summary",
                "showDetails": true
              }
            },
            {
              "id": "selected-object-topology",
              "type": "ui.jsonViewer",
              "area": "right",
              "title": "Topology",
              "visibleIf": "$state.inspectorTab === 'topology'",
              "dataSource": {
                "kind": "stream",
                "receiver": "infrascope.inspector_field.topology.$state.selectedObjectId"
              },
              "inputs": {
                "emptyText": "No topology data"
              }
            },
            {
              "id": "selected-object-task-packet",
              "type": "ui.jsonViewer",
              "area": "right",
              "title": "Task packet",
              "visibleIf": "$state.inspectorTab === 'task'",
              "dataSource": {
                "kind": "stream",
                "receiver": "infrascope.inspector_field.task_packet.$state.selectedObjectId"
              },
              "inputs": {
                "emptyText": "No task packet"
              }
            },
            {
              "id": "selected-object-planning",
              "type": "ui.jsonViewer",
              "area": "right",
              "title": "Subnet planning",
              "visibleIf": "$state.inspectorTab === 'planning'",
              "dataSource": {
                "kind": "stream",
                "receiver": "infrascope.inspector_field.subnet_planning.$state.selectedObjectId"
              },
              "inputs": {
                "emptyText": "No subnet planning context"
              }
            },
            {
              "id": "selected-object-actions",
              "type": "ui.list",
              "area": "right",
              "title": "Recommended actions",
              "visibleIf": "$state.inspectorTab === 'actions'",
              "dataSource": {
                "kind": "stream",
                "receiver": "infrascope.inspector_field.actions.$state.selectedObjectId"
              },
              "inputs": {
                "emptyText": "No actions available",
                "inset": true,
                "titleKey": "title",
                "subtitleKey": "risk",
                "showDetails": true
              }
            }
          ]
        }
      }
    }
  },
  "registry": {
    "widgets": [],
    "modals": []
  },
  "catalog": {
    "apps": [],
    "widgets": []
  },
  "data": {}
}

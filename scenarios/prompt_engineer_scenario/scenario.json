{
  "id": "prompt_engineer_scenario",
  "version": "0.1.0",
  "name": "Prompt IDE Workspace",
  "type": "desktop",
  "title": "Prompt IDE",
  "description": "Prompt engineering IDE workspace (draft layout).",
  "depends": [
    "prompt_engineer_skill"
  ],
  "workflow": {
    "initial_state": "tz",
    "states": {
      "tz": {
        "label": "Stage: TZ",
        "context": {
          "edit": ["base_tz"],
          "readonly": []
        },
        "actions": [
          {
            "id": "tz.execute",
            "label": "Execute",
            "trigger": "button",
            "tool": "prompt_engineer_skill.tz_execute",
            "next_state": "tz_add"
          }
        ]
      },
      "tz_add": {
        "label": "Stage: TZ addenda",
        "context": {
          "edit": ["tz_addenda"],
          "readonly": ["base_tz"]
        },
        "actions": [
          {
            "id": "tz_add.reset",
            "label": "Reset",
            "trigger": "button",
            "tool": "prompt_engineer_skill.tz_add_reset",
            "next_state": "tz"
          }
        ]
      }
    }
  },
  "ui": {
    "application": {
      "version": "0.1",
      "desktop": {
        "pageSchema": {
          "id": "prompt_ide",
          "title": "Prompt IDE",
          "layout": {
            "type": "split",
            "areas": [
              {
                "id": "sidebar",
                "role": "sidebar"
              },
              {
                "id": "main",
                "role": "main"
              },
              {
                "id": "right",
                "role": "aux"
              },
              {
                "id": "bottom",
                "role": "footer"
              }
            ]
          },
          "widgets": [
            {
              "id": "project-current",
              "type": "input.commandBar",
              "area": "sidebar",
              "title": "Current project",
              "inputs": {
                "buttons": [
                  {
                    "id": "select-project",
                    "label": "Select project"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:select-project",
                  "type": "openModal",
                  "params": {
                    "modalId": "project_selector"
                  }
                }
              ]
            },
            {
              "id": "project-tree",
              "type": "collection.tree",
              "area": "sidebar",
              "title": "Project",
              "dataSource": {
                "kind": "skill",
                "name": "prompt_engineer_skill.prompt_list_project_objects",
                "params": {
                  "project_type": "$state.currentProjectType",
                  "project_id": "$state.currentProjectId"
                }
              },
              "inputs": {
                "labelField": "label",
                "columns": 1,
                "selectedStateKey": "currentObjectId"
              },
              "actions": [
                {
                  "on": "select",
                  "type": "callHost",
                  "target": "scenario.workflow.set_state",
                  "params": {
                    "scenario_id": "prompt_engineer_scenario",
                    "state": "$event.workflow_state"
                  }
                },
                {
                  "on": "select",
                  "type": "updateState",
                  "params": {
                    "currentObjectType": "$event.object_type",
                    "currentObjectId": "$event.object_id",
                    "currentStage": "$event.workflow_state"
                  }
                }
              ]
            },
            {
              "id": "project-files",
              "type": "collection.grid",
              "area": "sidebar",
              "title": "Files",
              "dataSource": {
                "kind": "skill",
                "name": "prompt_engineer_skill.prompt_list_project_files",
                "params": {
                  "object_type": "$state.currentObjectType",
                  "object_id": "$state.currentObjectId"
                }
              },
              "inputs": {
                "labelField": "label",
                "columns": 1,
                "selectedStateKey": "currentFilePath"
              },
              "actions": [
                {
                  "on": "select",
                  "type": "updateState",
                  "params": {
                    "currentObjectType": "$event.object_type",
                    "currentObjectId": "$event.object_id",
                    "currentStage": "file",
                  "currentFilePath": "$event.path"
                  }
                }
              ]
            },
            {
              "id": "project-files-tools",
              "type": "input.commandBar",
              "area": "sidebar",
              "title": "Files tools",
              "inputs": {
                "size": "small",
                "buttons": [
                  {
                    "id": "snapshot",
                    "label": "Snapshot"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:snapshot",
                  "type": "callSkill",
                  "target": "prompt_engineer_skill.prompt_snapshot_project",
                  "params": {
                    "object_type": "$state.currentObjectType",
                    "object_id": "$state.currentObjectId"
                  }
                }
              ]
            },
            {
              "id": "tz-editor",
              "type": "item.textEditor",
              "area": "main",
              "title": "Technical Specification",
              "dataSource": {
                "kind": "skill",
                "name": "prompt_engineer_skill.prompt_get_tz_state",
                "params": {
                  "object_type": "$state.currentObjectType",
                  "object_id": "$state.currentObjectId"
                }
              },
              "inputs": {
                "mode": "markdown",
                "bindField": "base_tz"
              },
              "actions": [
                {
                  "on": "save",
                  "type": "callSkill",
                  "target": "prompt_engineer_skill.prompt_save_base_tz",
                  "params": {
                    "object_type": "$state.currentObjectType",
                    "object_id": "$state.currentObjectId",
                    "text": "$event.content"
                  }
                }
              ],
              "visibleIf": "$state.currentStage === 'tz'"
            },
            {
              "id": "tz-addenda",
              "type": "item.details",
              "area": "main",
              "title": "TZ Addenda",
              "dataSource": {
                "kind": "skill",
                "name": "prompt_engineer_skill.prompt_get_tz_state",
                "params": {
                  "object_type": "$state.currentObjectType",
                  "object_id": "$state.currentObjectId",
                  "refresh_token": "$state.tzAddendaRefresh"
                }
              },
              "inputs": {
                "bindField": "tz_addenda"
              },
              "visibleIf": "$state.currentStage === 'tz' || $state.currentStage === 'tz_add'"
            },
            {
              "id": "tz-addenda-controls",
              "type": "input.commandBar",
              "area": "main",
              "title": "TZ tools",
              "inputs": {
                "buttons": [
                  {
                    "id": "add-addendum",
                    "label": "Add addendum"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:add-addendum",
                  "type": "openModal",
                  "params": {
                    "modalId": "tz_addendum_modal"
                  }
                }
              ],
              "visibleIf": "$state.currentStage === 'tz' || $state.currentStage === 'tz_add'"
            },
            {
              "id": "code-viewer",
              "type": "item.codeViewer",
              "area": "main",
              "title": "Source file",
              "dataSource": {
                "kind": "skill",
                "name": "prompt_engineer_skill.prompt_read_project_file",
                "params": {
                  "object_type": "$state.currentObjectType",
                  "object_id": "$state.currentObjectId",
                  "path": "$state.currentFilePath"
                }
              },
              "inputs": {
                "bindField": "content",
                "languageField": "language"
              },
              "visibleIf": "$state.currentStage === 'file'"
            },
            {
              "id": "llm-artifacts",
              "type": "item.details",
              "area": "right",
              "title": "LLM Artifacts (draft)",
              "dataSource": {
                "kind": "static",
                "value": {
                  "items": []
                }
              }
            },
            {
              "id": "workflow-actions",
              "type": "input.commandBar",
              "area": "right",
              "title": "Workflow",
              "dataSource": {
                "kind": "y",
                "path": "data/prompt/workflow/next_actions"
              },
              "inputs": {
                "labelField": "label",
                "columns": 1
              },
              "actions": [
                {
                  "on": "click",
                  "type": "callHost",
                  "target": "scenario.workflow.action",
                  "params": {
                    "scenario_id": "prompt_engineer_scenario",
                    "action_id": "$event.id"
                  }
                },
                {
                  "on": "click",
                  "type": "callSkill",
                  "target": "prompt_engineer_skill.prompt_set_workflow_state",
                  "params": {
                    "object_type": "$state.currentObjectType",
                    "object_id": "$state.currentObjectId",
                    "state": "$event.next_state"
                  }
                },
                {
                  "on": "click",
                  "type": "updateState",
                  "params": {
                    "currentStage": "$event.next_state"
                  }
                }
              ]
            },
            {
              "id": "status-toolbar",
              "type": "input.commandBar",
              "area": "bottom",
              "inputs": {
                "size": "small",
                "buttons": [
                  {
                    "id": "dev-webspace",
                    "label": "dev webspace: default"
                  },
                  {
                    "id": "target-node",
                    "label": "target: local"
                  },
                  {
                    "id": "llm-profile",
                    "label": "LLM profile: openai:gpt-4.1-mini"
                  },
                  {
                    "id": "llm-status",
                    "label": "LLM: idle"
                  },
                  {
                    "id": "git-status",
                    "label": "git: clean"
                  },
                  {
                    "id": "current-object",
                    "label": "$state.currentObjectId"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:current-object",
                  "type": "openModal",
                  "params": {
                    "modalId": "project_meta_modal"
                  }
                }
              ]
            }
          ]
        }
      },
      "modals": {
        "project_selector": {
          "title": "Select project",
          "schema": {
            "id": "project_selector",
            "layout": {
              "type": "single",
              "areas": [
                {
                  "id": "main",
                  "role": "main"
                }
              ]
            },
            "widgets": [
              {
                "id": "project-select-list",
                "type": "collection.grid",
                "area": "main",
                "title": "Dev projects",
                "inputs": {
                  "labelField": "label",
                  "columns": 1
                },
                "dataSource": {
                  "kind": "skill",
                  "name": "prompt_engineer_skill.prompt_list_dev_objects"
                },
              "actions": [
                {
                  "on": "select",
                  "type": "callHost",
                  "target": "scenario.workflow.set_state",
                  "params": {
                    "scenario_id": "prompt_engineer_scenario",
                    "state": "$event.workflow_state"
                  }
                },
                {
                  "on": "select",
                  "type": "updateState",
                  "params": {
                    "currentProjectType": "$event.object_type",
                    "currentProjectId": "$event.object_id",
                    "currentObjectType": "$event.object_type",
                    "currentObjectId": "$event.object_id",
                    "currentStage": "$event.workflow_state"
                  }
                }
              ]
              },
              {
                "id": "project-create-kind",
                "type": "input.selector",
                "area": "main",
                "title": "Create: type",
                "inputs": {
                  "options": [
                    "scenario",
                    "skill"
                  ]
                },
                "actions": [
                  {
                    "on": "change",
                    "type": "updateState",
                    "params": {
                      "createObjectType": "$event.value"
                    }
                  }
                ]
              },
              {
                "id": "project-create-name",
                "type": "input.text",
                "area": "main",
                "title": "Create: name",
                "inputs": {
                  "placeholder": "my_new_project"
                },
                "actions": [
                  {
                    "on": "change",
                    "type": "updateState",
                    "params": {
                      "createObjectName": "$event.value"
                    }
                  }
                ]
              },
              {
                "id": "project-create-template",
                "type": "input.selector",
                "area": "main",
                "title": "Create: template",
                "dataSource": {
                  "kind": "skill",
                  "name": "prompt_engineer_skill.prompt_list_templates",
                  "params": {
                    "object_type": "$state.createObjectType"
                  }
                },
                "inputs": {
                  "label": "Template"
                },
                "actions": [
                  {
                    "on": "change",
                    "type": "updateState",
                    "params": {
                      "createTemplateName": "$event.value"
                    }
                  }
                ]
              },
              {
                "id": "project-create-actions",
                "type": "input.commandBar",
                "area": "main",
                "inputs": {
                  "buttons": [
                    {
                      "id": "create",
                      "label": "Create"
                    }
                  ]
                },
                "actions": [
                  {
                    "on": "click:create",
                    "type": "callSkill",
                    "target": "prompt_engineer_skill.prompt_create_dev_project",
                    "params": {
                      "object_type": "$state.createObjectType",
                      "name": "$state.createObjectName",
                      "template": "$state.createTemplateName"
                    }
                  },
                  {
                    "on": "click:create",
                    "type": "updateState",
                    "params": {
                      "currentObjectType": "$state.createObjectType",
                      "currentObjectId": "$state.createObjectName",
                      "currentStage": "tz"
                    }
                  }
                ]
              }
            ]
          }
        },
        "project_meta_modal": {
          "title": "Project details",
          "schema": {
            "id": "project_meta_modal",
            "layout": {
              "type": "single",
              "areas": [
                {
                  "id": "main",
                  "role": "main"
                }
              ]
            },
            "widgets": [
              {
                "id": "project-meta-view",
                "type": "item.details",
                "area": "main",
                "title": "Current metadata",
                "dataSource": {
                  "kind": "skill",
                  "name": "prompt_engineer_skill.prompt_get_project_meta",
                  "params": {
                    "object_type": "$state.currentProjectType",
                    "object_id": "$state.currentProjectId"
                  }
                }
              },
              {
                "id": "project-meta-title",
                "type": "input.text",
                "area": "main",
                "title": "Title",
                "dataSource": {
                  "kind": "skill",
                  "name": "prompt_engineer_skill.prompt_get_project_meta",
                  "params": {
                    "object_type": "$state.currentProjectType",
                    "object_id": "$state.currentProjectId"
                  }
                },
                "inputs": {
                  "placeholder": "Title",
                  "bindField": "title"
                },
                "actions": [
                  {
                    "on": "change",
                    "type": "updateState",
                    "params": {
                      "editProjectTitle": "$event.value"
                    }
                  }
                ]
              },
              {
                "id": "project-meta-description",
                "type": "item.textEditor",
                "area": "main",
                "title": "Description",
                "dataSource": {
                  "kind": "skill",
                  "name": "prompt_engineer_skill.prompt_get_project_meta",
                  "params": {
                    "object_type": "$state.currentProjectType",
                    "object_id": "$state.currentProjectId"
                  }
                },
                "inputs": {
                  "mode": "markdown",
                  "bindField": "description"
                },
                "actions": []
              },
              {
                "id": "project-meta-type",
                "type": "input.selector",
                "area": "main",
                "title": "Type",
                "inputs": {
                  "options": [
                    "desktop",
                    "chat",
                    "voice"
                  ]
                },
                "actions": [
                  {
                    "on": "change",
                    "type": "updateState",
                    "params": {
                      "editProjectType": "$event.value"
                    }
                  }
                ]
              },
              {
                "id": "project-meta-actions",
                "type": "input.commandBar",
                "area": "main",
                "inputs": {
                  "buttons": [
                    {
                      "id": "save",
                      "label": "Save"
                    }
                  ]
                },
                "actions": [
                  {
                    "on": "click:save",
                    "type": "callSkill",
                    "target": "prompt_engineer_skill.prompt_update_project_meta",
                    "params": {
                      "object_type": "$state.currentProjectType",
                      "object_id": "$state.currentProjectId",
                      "title": "$state.editProjectTitle",
                      "description": "$state.editProjectDescription",
                      "type": "$state.editProjectType"
                    }
                  }
                ]
              }
            ]
          }
        },
        "tz_addendum_modal": {
          "title": "Add TZ addendum",
          "schema": {
            "id": "tz_addendum_modal",
            "layout": {
              "type": "single",
              "areas": [
                {
                  "id": "main",
                  "role": "main"
                }
              ]
            },
            "widgets": [
              {
                "id": "tz-addendum-editor",
                "type": "item.textEditor",
                "area": "main",
                "title": "Add TZ addendum",
                "dataSource": {
                  "kind": "static",
                  "value": {
                    "content": ""
                  }
                },
                "inputs": {
                  "mode": "markdown",
                  "bindField": "content"
                },
                "actions": [
                  {
                    "on": "save",
                    "type": "callSkill",
                    "target": "prompt_engineer_skill.prompt_append_tz_addendum",
                    "params": {
                      "object_type": "$state.currentObjectType",
                      "object_id": "$state.currentObjectId",
                      "text": "$event.content"
                    }
                  },
                  {
                    "on": "save",
                    "type": "updateState",
                    "params": {
                      "tzAddendaRefresh": "$event.ts"
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    }
  },
  "registry": {
    "widgets": [],
    "modals": []
  },
  "catalog": {
    "apps": [],
    "widgets": []
  },
  "data": {}
}

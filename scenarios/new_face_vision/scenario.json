{
  "id": "new_face_vision_scenario",
  "version": "0.2.0",
  "name": "new_face_vision",
  "type": "desktop",
  "title": "New Face Vision",
  "description": "Desktop scenario for frame analysis through new_face_vision_skill.",
  "depends": [
    "new_face_vision_skill"
  ],
  "workflow": {
    "initial_state": "init",
    "states": {
      "init": {
        "label": "Init",
        "context": {
          "edit": [],
          "readonly": []
        },
        "actions": [
          {
            "id": "load_model",
            "label": "Load model",
            "trigger": "button",
            "tool": "new_face_vision_skill.new_face_vision_load_model",
            "next_state": "ready"
          }
        ]
      },
      "ready": {
        "label": "Ready",
        "context": {
          "edit": [],
          "readonly": [
            "model_loaded"
          ]
        },
        "actions": [
          {
            "id": "load_frames",
            "label": "Load frames",
            "trigger": "button",
            "tool": "new_face_vision_skill.new_face_vision_load_frames",
            "next_state": "ready"
          },
          {
            "id": "load_masks",
            "label": "Load masks",
            "trigger": "button",
            "tool": "new_face_vision_skill.new_face_vision_load_masks",
            "next_state": "ready"
          }
        ]
      },
      "analyze": {
        "label": "Analyze",
        "context": {
          "edit": [],
          "readonly": [
            "current_frame",
            "preview"
          ]
        },
        "actions": [
          {
            "id": "next_frame",
            "label": "Next frame",
            "trigger": "button",
            "tool": "new_face_vision_skill.new_face_vision_play_step",
            "next_state": "analyze"
          },
          {
            "id": "reset",
            "label": "Reset",
            "trigger": "button",
            "tool": "new_face_vision_skill.new_face_vision_reset",
            "next_state": "ready"
          },
          {
            "id": "clear",
            "label": "Clear",
            "trigger": "button",
            "tool": "new_face_vision_skill.new_face_vision_clear",
            "next_state": "init"
          }
        ]
      }
    }
  },
  "ui": {
    "application": {
      "version": "0.2",
      "desktop": {
        "pageSchema": {
          "id": "new_face_vision",
          "title": "New Face Vision",
          "surfaceClass": "operations",
          "layout": {
            "type": "split",
            "pattern": "split",
            "areas": [
              {
                "id": "sidebar",
                "role": "sidebar"
              },
              {
                "id": "main",
                "role": "main"
              },
              {
                "id": "right",
                "role": "aux"
              },
              {
                "id": "bottom",
                "role": "footer"
              }
            ]
          },
          "widgets": [
            {
              "id": "model-upload",
              "type": "input.fileUpload",
              "area": "right",
              "title": "Model file",
              "inputs": {
                "skill": "new_face_vision_skill",
                "purpose": "model",
                "accept": ".pt,.pth,.onnx,application/octet-stream",
                "label": "Upload model",
                "maxBytes": 1073741824
              },
              "actions": [
                {
                  "on": "uploaded",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_load_model",
                  "params": {
                    "artifact_ref": "$event.artifact_ref"
                  }
                }
              ]
            },
            {
              "id": "frames-upload",
              "type": "input.fileUpload",
              "area": "right",
              "title": "Frames ZIP",
              "inputs": {
                "skill": "new_face_vision_skill",
                "purpose": "frames",
                "accept": ".zip,application/zip",
                "label": "Upload frames",
                "maxBytes": 1073741824
              },
              "actions": [
                {
                  "on": "uploaded",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_load_frames",
                  "params": {
                    "artifact_ref": "$event.artifact_ref"
                  }
                }
              ]
            },
            {
              "id": "masks-upload",
              "type": "input.fileUpload",
              "area": "right",
              "title": "Masks ZIP",
              "inputs": {
                "skill": "new_face_vision_skill",
                "purpose": "masks",
                "accept": ".zip,application/zip",
                "label": "Upload masks",
                "maxBytes": 1073741824
              },
              "actions": [
                {
                  "on": "uploaded",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_load_masks",
                  "params": {
                    "artifact_ref": "$event.artifact_ref"
                  }
                }
              ]
            },
            {
              "id": "metadata-upload",
              "type": "input.fileUpload",
              "area": "right",
              "title": "Metadata JSONL",
              "inputs": {
                "skill": "new_face_vision_skill",
                "purpose": "metadata",
                "accept": ".jsonl,.json,application/json,text/plain",
                "label": "Upload metadata",
                "maxBytes": 67108864
              },
              "actions": [
                {
                  "on": "uploaded",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_load_metadata",
                  "params": {
                    "artifact_ref": "$event.artifact_ref"
                  }
                }
              ]
            },
            {
              "id": "bad-ratio",
              "type": "visual.metricTile",
              "area": "right",
              "title": "Bad ratio",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/current/latest"
              },
              "inputs": {
                "valuePath": "pred_ratio",
                "format": "percent",
                "emptyText": "--%",
                "descriptionPath": "description"
              }
            },
            {
              "id": "pipeline-status",
              "type": "visual.metricTile",
              "area": "right",
              "title": "Status",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/current"
              },
              "inputs": {
                "valuePath": "status",
                "descriptionPath": "operation.label",
                "emptyText": "init"
              }
            },
            {
              "id": "total-frames",
              "type": "visual.metricTile",
              "area": "right",
              "title": "Frames",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/current/stats"
              },
              "inputs": {
                "valuePath": "total_frames",
                "format": "integer",
                "descriptionPath": "next_frame"
              }
            },
            {
              "id": "model-state",
              "type": "visual.metricTile",
              "area": "right",
              "title": "Model",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/current/model"
              },
              "inputs": {
                "valuePath": "loaded",
                "format": "boolean",
                "trueText": "Loaded",
                "falseText": "No model"
              }
            },
            {
              "id": "compact-state",
              "type": "ui.jsonViewer",
              "area": "bottom",
              "title": "Compact state",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/current"
              }
            },
            {
              "id": "frame-stream",
              "type": "visual.frameViewer",
              "area": "main",
              "title": "Preview",
              "dataSource": {
                "kind": "stream",
                "receiver": "newface_vision_frame"
              },
              "inputs": {
                "imageField": "image.src",
                "aspectRatio": "16 / 9",
                "emptyText": "No frame yet",
                "metrics": [
                  {
                    "label": "Pred",
                    "path": "prediction.pred_ratio"
                  },
                  {
                    "label": "True",
                    "path": "prediction.true_ratio"
                  },
                  {
                    "label": "Dice",
                    "path": "metrics.dice"
                  },
                  {
                    "label": "IoU",
                    "path": "metrics.iou"
                  }
                ]
              }
            },
            {
              "id": "latest-result",
              "type": "visual.metricTile",
              "area": "right",
              "title": "Latest frame",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/current/latest"
              },
              "inputs": {
                "valuePath": "label",
                "descriptionPath": "description",
                "emptyText": "--"
              }
            },
            {
              "id": "bad-ratio-stream",
              "type": "visual.timeseriesChart",
              "area": "right",
              "title": "Bad ratio trend",
              "dataSource": {
                "kind": "stream",
                "receiver": "newface_vision_metrics"
              },
              "inputs": {
                "xKey": "frame_idx",
                "yKey": "series.pred_ratio",
                "emptyText": "No metric points"
              }
            },
            {
              "id": "metrics-stream",
              "type": "visual.timeseriesChart",
              "area": "right",
              "title": "Dice trend",
              "dataSource": {
                "kind": "stream",
                "receiver": "newface_vision_metrics"
              },
              "inputs": {
                "xKey": "frame_idx",
                "yKey": "series.dice",
                "emptyText": "No metric points"
              }
            },
            {
              "id": "controls",
              "type": "input.commandBar",
              "area": "main",
              "title": "Controls",
              "inputs": {
                "buttons": [
                  {
                    "id": "play",
                    "label": "Next frame",
                    "icon": "play"
                  },
                  {
                    "id": "reset",
                    "label": "Reset",
                    "icon": "refresh"
                  },
                  {
                    "id": "clear",
                    "label": "Clear",
                    "icon": "trash",
                    "kind": "danger"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:play",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_play_step"
                },
                {
                  "on": "click:reset",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_reset"
                },
                {
                  "on": "click:clear",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_clear"
                }
              ]
            }
          ]
        }
      },
      "modals": {
        "load_model": {
          "title": "Load model",
          "schema": {
            "id": "load_model",
            "layout": {
              "type": "single",
              "pattern": "stack",
              "areas": [
                {
                  "id": "main",
                  "role": "main"
                }
              ]
            },
            "widgets": [
              {
                "id": "model-upload",
                "type": "input.fileUpload",
                "area": "main",
                "title": "Model file",
                "inputs": {
                  "skill": "new_face_vision_skill",
                  "purpose": "model",
                  "accept": ".pt,.pth,.onnx,application/octet-stream",
                  "label": "Upload model",
                  "maxBytes": 1073741824
                },
                "actions": [
                  {
                    "on": "uploaded",
                    "type": "callSkill",
                    "target": "new_face_vision_skill.new_face_vision_load_model",
                    "params": {
                      "artifact_ref": "$event.artifact_ref"
                    }
                  }
                ]
              }
            ]
          }
        },
        "load_frames": {
          "title": "Load frames",
          "schema": {
            "id": "load_frames",
            "layout": {
              "type": "single",
              "pattern": "stack",
              "areas": [
                {
                  "id": "main",
                  "role": "main"
                }
              ]
            },
            "widgets": [
              {
                "id": "frames-upload",
                "type": "input.fileUpload",
                "area": "main",
                "title": "Frames ZIP",
                "inputs": {
                  "skill": "new_face_vision_skill",
                  "purpose": "frames",
                  "accept": ".zip,application/zip",
                  "label": "Upload frames",
                  "maxBytes": 1073741824
                },
                "actions": [
                  {
                    "on": "uploaded",
                    "type": "callSkill",
                    "target": "new_face_vision_skill.new_face_vision_load_frames",
                    "params": {
                      "artifact_ref": "$event.artifact_ref"
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    }
  },
  "registry": {
    "widgets": [],
    "modals": []
  },
  "catalog": {
    "apps": [],
    "widgets": []
  },
  "data": {}
}

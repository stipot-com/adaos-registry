{
  "id": "new_face_vision_scenario",
  "version": "0.2.0",
  "name": "new_face_vision",
  "type": "desktop",
  "title": "New Face Vision",
  "description": "Desktop scenario for frame analysis through new_face_vision_skill.",
  "depends": [
    "new_face_vision_skill"
  ],
  "workflow": {
    "initial_state": "init",
    "states": {
      "init": {
        "label": "Init",
        "context": {
          "edit": [],
          "readonly": []
        },
        "actions": [
          {
            "id": "load_model",
            "label": "Load model",
            "trigger": "button",
            "tool": "new_face_vision_skill.new_face_vision_load_model",
            "next_state": "ready"
          }
        ]
      },
      "ready": {
        "label": "Ready",
        "context": {
          "edit": [],
          "readonly": [
            "model_loaded"
          ]
        },
        "actions": [
          {
            "id": "load_frames",
            "label": "Load frames",
            "trigger": "button",
            "tool": "new_face_vision_skill.new_face_vision_load_frames",
            "next_state": "ready"
          },
          {
            "id": "load_masks",
            "label": "Load masks",
            "trigger": "button",
            "tool": "new_face_vision_skill.new_face_vision_load_masks",
            "next_state": "ready"
          }
        ]
      },
      "analyze": {
        "label": "Analyze",
        "context": {
          "edit": [],
          "readonly": [
            "current_frame",
            "preview"
          ]
        },
        "actions": [
          {
            "id": "next_frame",
            "label": "Next frame",
            "trigger": "button",
            "tool": "new_face_vision_skill.new_face_vision_play_step",
            "next_state": "analyze"
          },
          {
            "id": "reset",
            "label": "Reset",
            "trigger": "button",
            "tool": "new_face_vision_skill.new_face_vision_reset",
            "next_state": "ready"
          },
          {
            "id": "clear",
            "label": "Clear",
            "trigger": "button",
            "tool": "new_face_vision_skill.new_face_vision_clear",
            "next_state": "init"
          }
        ]
      }
    }
  },
  "ui": {
    "application": {
      "version": "0.2",
      "desktop": {
        "pageSchema": {
          "id": "new_face_vision",
          "title": "New Face Vision",
          "layout": {
            "type": "split",
            "pattern": "split",
            "areas": [
              {
                "id": "sidebar",
                "role": "sidebar"
              },
              {
                "id": "main",
                "role": "main"
              },
              {
                "id": "right",
                "role": "aux"
              }
            ]
          },
          "widgets": [
            {
              "id": "compact-state",
              "type": "ui.jsonViewer",
              "area": "sidebar",
              "title": "Compact state",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/current"
              }
            },
            {
              "id": "frame-stream",
              "type": "ui.jsonViewer",
              "area": "main",
              "title": "Frame stream",
              "dataSource": {
                "kind": "stream",
                "receiver": "newface_vision_frame"
              }
            },
            {
              "id": "latest-result",
              "type": "visual.metricTile",
              "area": "right",
              "title": "Latest result",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/current/latest"
              }
            },
            {
              "id": "metrics-stream",
              "type": "ui.jsonViewer",
              "area": "right",
              "title": "Metrics stream",
              "dataSource": {
                "kind": "stream",
                "receiver": "newface_vision_metrics"
              }
            },
            {
              "id": "controls",
              "type": "input.commandBar",
              "area": "sidebar",
              "title": "Controls",
              "inputs": {
                "buttons": [
                  {
                    "id": "play",
                    "label": "Next frame",
                    "icon": "play"
                  },
                  {
                    "id": "reset",
                    "label": "Reset",
                    "icon": "refresh"
                  },
                  {
                    "id": "clear",
                    "label": "Clear",
                    "icon": "trash",
                    "kind": "danger"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:play",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_play_step"
                },
                {
                  "on": "click:reset",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_reset"
                },
                {
                  "on": "click:clear",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_clear"
                }
              ]
            }
          ]
        }
      },
      "modals": {
        "load_model": {
          "title": "Load model",
          "schema": {
            "id": "load_model",
            "layout": {
              "type": "single",
              "pattern": "stack",
              "areas": [
                {
                  "id": "main",
                  "role": "main"
                }
              ]
            },
            "widgets": [
              {
                "id": "model-path",
                "type": "input.text",
                "area": "main",
                "title": "Model path",
                "inputs": {
                  "placeholder": "C:\\path\\to\\model.pth"
                },
                "actions": [
                  {
                    "on": "change",
                    "type": "updateState",
                    "params": {
                      "modelPath": "$event.value"
                    }
                  }
                ]
              },
              {
                "id": "load-button",
                "type": "input.commandBar",
                "area": "main",
                "inputs": {
                  "buttons": [
                    {
                      "id": "load",
                      "label": "Load"
                    }
                  ]
                },
                "actions": [
                  {
                    "on": "click:load",
                    "type": "callSkill",
                    "target": "new_face_vision_skill.new_face_vision_load_model",
                    "params": {
                      "path": "$state.modelPath"
                    }
                  }
                ]
              }
            ]
          }
        },
        "load_frames": {
          "title": "Load frames",
          "schema": {
            "id": "load_frames",
            "layout": {
              "type": "single",
              "pattern": "stack",
              "areas": [
                {
                  "id": "main",
                  "role": "main"
                }
              ]
            },
            "widgets": [
              {
                "id": "frames-path",
                "type": "input.text",
                "area": "main",
                "title": "Frames ZIP path",
                "inputs": {
                  "placeholder": "C:\\path\\to\\frames.zip"
                },
                "actions": [
                  {
                    "on": "change",
                    "type": "updateState",
                    "params": {
                      "framesPath": "$event.value"
                    }
                  }
                ]
              },
              {
                "id": "load-frames-button",
                "type": "input.commandBar",
                "area": "main",
                "inputs": {
                  "buttons": [
                    {
                      "id": "load",
                      "label": "Load"
                    }
                  ]
                },
                "actions": [
                  {
                    "on": "click:load",
                    "type": "callSkill",
                    "target": "new_face_vision_skill.new_face_vision_load_frames",
                    "params": {
                      "path": "$state.framesPath"
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    }
  },
  "registry": {
    "widgets": [],
    "modals": []
  },
  "catalog": {
    "apps": [],
    "widgets": []
  },
  "data": {}
}

{
  "$schema": "../../../../src/adaos/abi/scenario.schema.json",
  "id": "taiga_ui_demo_scenario",
  "version": "0.1.0",
  "name": "Taiga UI Demo Scenario",
  "type": "desktop",
  "title": "Taiga UI Demo",
  "description": "Control scenario for the first semantic Web UI slice with a shared metrics table, chart payload, and event stream.",
  "depends": [
    "web_desktop_skill",
    "demo_metrics_skill"
  ],
  "ui": {
    "application": {
      "version": "0.1",
      "desktop": {
        "pageSchema": {
          "id": "taiga_ui_demo",
          "title": "Taiga UI Demo",
          "layout": {
            "type": "split",
            "areas": [
              { "id": "sidebar", "role": "sidebar" },
              { "id": "main", "role": "main" },
              { "id": "right", "role": "aux" },
              { "id": "bottom", "role": "footer" }
            ]
          },
          "widgets": [
            {
              "id": "demo-launch",
              "type": "input.commandBar",
              "area": "sidebar",
              "title": "Demo",
              "inputs": {
                "buttons": [
                  {
                    "id": "open-demo",
                    "label": "Open Demo Metrics"
                  },
                  {
                    "id": "open-workspace",
                    "label": "Workspace"
                  },
                  {
                    "id": "open-workspace-shell",
                    "label": "Workspace shell"
                  },
                  {
                    "id": "open-operations",
                    "label": "Operations"
                  },
                  {
                    "id": "emit-skill",
                    "label": "Skill event"
                  },
                  {
                    "id": "emit-host",
                    "label": "Host event"
                  }
                ],
                "size": "small"
              },
              "actions": [
                {
                  "on": "click:open-demo",
                  "type": "openModal",
                  "params": {
                    "modalId": "demo_metrics_modal"
                  }
                },
                {
                  "on": "click:open-workspace",
                  "type": "openWorkspace",
                  "params": {
                    "modalId": "workspace_manager",
                    "workspaceRef": "workspace:demo_metrics",
                    "entityRef": "scenario:taiga_ui_demo_scenario"
                  }
                },
                {
                  "on": "click:open-workspace-shell",
                  "type": "openWorkspace",
                  "params": {
                    "surfaceRoute": "workspace"
                  }
                },
                {
                  "on": "click:open-operations",
                  "type": "openModal",
                  "params": {
                    "modalId": "demo_metrics_operations_modal"
                  }
                },
                {
                  "on": "click:emit-skill",
                  "type": "callSkill",
                  "target": "demo_metrics_skill.emit_demo_event",
                  "params": {
                    "action_id": "desktop_skill_button",
                    "metric_id": "$state.demo_metrics.selection.metric_id"
                  }
                },
                {
                  "on": "click:emit-host",
                  "type": "callHost",
                  "target": "demo_metrics.host_action",
                  "params": {
                    "action_id": "desktop_host_button",
                    "metric_id": "$state.demo_metrics.selection.metric_id"
                  }
                }
              ]
            },
            {
              "id": "demo-summary",
              "type": "visual.metricTile",
              "area": "main",
              "title": "Summary",
              "dataSource": {
                "kind": "y",
                "path": "data/demo_metrics/summary"
              },
              "actions": [
                {
                  "on": "click:open-demo",
                  "type": "openModal",
                  "params": {
                    "modalId": "demo_metrics_modal"
                  }
                },
                {
                  "on": "click:open-workspace",
                  "type": "openWorkspace",
                  "params": {
                    "modalId": "workspace_manager",
                    "workspaceRef": "workspace:demo_metrics",
                    "entityRef": "scenario:taiga_ui_demo_scenario"
                  }
                },
                {
                  "on": "click:open-workspace-shell",
                  "type": "openWorkspace",
                  "params": {
                    "surfaceRoute": "workspace"
                  }
                },
                {
                  "on": "click:open-operations",
                  "type": "openModal",
                  "params": {
                    "modalId": "demo_metrics_operations_modal"
                  }
                },
                {
                  "on": "click:emit-skill",
                  "type": "callSkill",
                  "target": "demo_metrics_skill.emit_demo_event",
                  "params": {
                    "action_id": "summary_skill_button",
                    "metric_id": "$state.demo_metrics.selection.metric_id"
                  }
                },
                {
                  "on": "click:emit-host",
                  "type": "callHost",
                  "target": "demo_metrics.host_action",
                  "params": {
                    "action_id": "summary_host_button",
                    "metric_id": "$state.demo_metrics.selection.metric_id"
                  }
                }
              ]
            },
            {
              "id": "demo-table",
              "type": "ui.table",
              "area": "main",
              "title": "Metrics table",
              "dataSource": {
                "kind": "y",
                "path": "data/demo_metrics/table"
              },
              "inputs": {
                "columns": [
                  { "key": "title", "label": "Metric" },
                  { "key": "status", "label": "Status", "width": "120px" },
                  { "key": "value", "label": "Value", "width": "100px" },
                  { "key": "unit", "label": "Unit", "width": "90px" }
                ],
                "emptyText": "No demo metrics yet"
              }
            },
            {
              "id": "demo-chart-payload",
              "type": "visual.metricChart",
              "area": "right",
              "title": "Metric trend",
              "dataSource": {
                "kind": "y",
                "path": "data/demo_metrics/chart"
              },
              "inputs": {
                "stateKey": "demo_metrics.selection",
                "xKey": "ts",
                "yKey": "value",
                "emptyText": "No chart payload yet"
              }
            },
            {
              "id": "demo-events",
              "type": "ui.list",
              "area": "bottom",
              "title": "Events",
              "dataSource": {
                "kind": "stream",
                "receiver": "demo_metrics.events"
              },
              "inputs": {
                "titleKey": "title",
                "subtitleKey": "description",
                "showDetails": false,
                "itemAccordion": false,
                "emptyText": "No demo events yet"
              }
            },
            {
              "id": "demo-chat",
              "type": "ui.chat",
              "area": "bottom",
              "title": "Operator notes",
              "dataSource": {
                "kind": "y",
                "path": "data/demo_metrics/chat"
              },
              "inputs": {
                "hint": "Notes are seeded from shared demo state.",
                "alignRightFrom": "operator"
              }
            }
          ],
          "semantic": {
            "$schema": "../../../../src/adaos/abi/webui.semantic.v0.schema.json",
            "id": "taiga_ui_demo_surface",
            "title": "Taiga UI Demo Surface",
            "workspace": {
              "surfaceClass": "workspace",
              "objectKind": "demo_metric_suite",
              "entityRef": "scenario:taiga_ui_demo_scenario",
              "capabilities": [
                "inspectable",
                "listable",
                "streamable",
                "eventful"
              ],
              "lifecycleStage": "active"
            },
            "layout": {
              "pattern": "split",
              "areas": [
                { "id": "main", "role": "main" },
                { "id": "right", "role": "aux" },
                { "id": "bottom", "role": "footer" }
              ]
            },
            "load": {
              "structure": "eager",
              "data": "visible",
              "focus": "primary",
              "offFocusReadyState": "hydrating"
            },
            "viewState": [
              {
                "ref": "view:demo_metrics.selection",
                "default": {
                  "metric_id": "cpu",
                  "status_filter": "all",
                  "group_filter": "all"
                },
                "persistence": "local_persisted"
              }
            ],
            "views": [
              {
                "id": "demo_metrics_grid",
                "kind": "collection_grid",
                "area": "main",
                "title": "Metrics table",
                "when": {
                  "requiredCapabilities": ["listable"],
                  "surfaceClasses": ["workspace"],
                  "lifecycleStages": ["active"]
                },
                "source": {
                  "kind": "y",
                  "ref": "y:data/demo_metrics/table",
                  "scope": "shared"
                },
                "selection": {
                  "kind": "view",
                  "ref": "view:demo_metrics.selection",
                  "scope": "local"
                },
                "config": {
                  "columns": [
                    { "key": "title", "label": "Metric" },
                    { "key": "status", "label": "Status" },
                    { "key": "value", "label": "Value" },
                    { "key": "unit", "label": "Unit" },
                    { "key": "group", "label": "Group" }
                  ]
                },
                "actions": [
                  {
                    "ref": "action:view.demo_metrics.select_metric",
                    "kind": "set_view_state",
                    "trigger": "select",
                    "payload": {
                      "metric_id": "$event.id"
                    }
                  }
                ]
              },
              {
                "id": "demo_metric_chart",
                "kind": "metric_chart",
                "area": "right",
                "title": "Metric trend",
                "when": {
                  "requiredCapabilities": ["inspectable"],
                  "surfaceClasses": ["workspace"],
                  "lifecycleStages": ["active"]
                },
                "source": {
                  "kind": "y",
                  "ref": "y:data/demo_metrics/chart",
                  "scope": "shared"
                },
                "selection": {
                  "kind": "view",
                  "ref": "view:demo_metrics.selection",
                  "scope": "local"
                },
                "config": {
                  "xKey": "ts",
                  "yKey": "value"
                }
              },
              {
                "id": "demo_metric_events",
                "kind": "event_log",
                "area": "bottom",
                "title": "Events",
                "when": {
                  "requiredCapabilities": ["eventful"],
                  "surfaceClasses": ["workspace"],
                  "lifecycleStages": ["active"]
                },
                "source": {
                  "kind": "stream",
                  "ref": "stream:demo_metrics.events",
                  "scope": "shared",
                  "transport": "auto"
                }
              },
              {
                "id": "demo_metric_chat",
                "kind": "chat_panel",
                "area": "bottom",
                "title": "Operator notes",
                "when": {
                  "requiredCapabilities": ["streamable"],
                  "surfaceClasses": ["workspace"],
                  "lifecycleStages": ["active"]
                },
                "source": {
                  "kind": "y",
                  "ref": "y:data/demo_metrics/chat",
                  "scope": "shared"
                },
                "config": {
                  "hint": "Notes are seeded from shared demo state.",
                  "alignRightFrom": "operator"
                }
              }
            ]
          }
        }
      },
      "workspace": {
        "pageSchema": {
          "id": "taiga_ui_demo_workspace",
          "title": "Demo Metrics Workspace",
          "layout": {
            "type": "split",
            "areas": [
              { "id": "main", "role": "main" },
              { "id": "right", "role": "aux" },
              { "id": "bottom", "role": "footer" }
            ]
          },
          "widgets": [],
          "semantic": {
            "$schema": "../../../../src/adaos/abi/webui.semantic.v0.schema.json",
            "id": "taiga_ui_demo_workspace_surface",
            "title": "Demo Metrics Workspace Surface",
            "workspace": {
              "surfaceClass": "workspace",
              "objectKind": "demo_metric_suite",
              "entityRef": "scenario:taiga_ui_demo_scenario",
              "capabilities": [
                "inspectable",
                "listable",
                "streamable",
                "eventful"
              ],
              "lifecycleStage": "active"
            },
            "layout": {
              "pattern": "split",
              "areas": [
                { "id": "main", "role": "main" },
                { "id": "right", "role": "aux" },
                { "id": "bottom", "role": "footer" }
              ]
            },
            "load": {
              "structure": "eager",
              "data": "visible",
              "focus": "primary",
              "offFocusReadyState": "hydrating"
            },
            "viewState": [
              {
                "ref": "view:demo_metrics.selection",
                "default": {
                  "metric_id": "cpu",
                  "status_filter": "all",
                  "group_filter": "all"
                },
                "persistence": "local_persisted"
              }
            ],
            "views": [
              {
                "id": "workspace_metrics_grid",
                "kind": "collection_grid",
                "area": "main",
                "title": "Metrics table",
                "when": {
                  "requiredCapabilities": ["listable"],
                  "surfaceClasses": ["workspace"],
                  "lifecycleStages": ["active"]
                },
                "source": {
                  "kind": "y",
                  "ref": "y:data/demo_metrics/table",
                  "scope": "shared"
                },
                "selection": {
                  "kind": "view",
                  "ref": "view:demo_metrics.selection",
                  "scope": "local"
                },
                "config": {
                  "columns": [
                    { "key": "title", "label": "Metric" },
                    { "key": "status", "label": "Status" },
                    { "key": "value", "label": "Value" },
                    { "key": "unit", "label": "Unit" },
                    { "key": "group", "label": "Group" }
                  ]
                },
                "actions": [
                  {
                    "ref": "action:view.demo_metrics.select_metric",
                    "kind": "set_view_state",
                    "trigger": "select",
                    "payload": {
                      "metric_id": "$event.id"
                    }
                  }
                ]
              },
              {
                "id": "workspace_metric_chart",
                "kind": "metric_chart",
                "area": "right",
                "title": "Metric trend",
                "when": {
                  "requiredCapabilities": ["inspectable"],
                  "surfaceClasses": ["workspace"],
                  "lifecycleStages": ["active"]
                },
                "source": {
                  "kind": "y",
                  "ref": "y:data/demo_metrics/chart",
                  "scope": "shared"
                },
                "selection": {
                  "kind": "view",
                  "ref": "view:demo_metrics.selection",
                  "scope": "local"
                },
                "config": {
                  "xKey": "ts",
                  "yKey": "value"
                }
              },
              {
                "id": "workspace_metric_events",
                "kind": "event_log",
                "area": "bottom",
                "title": "Events",
                "when": {
                  "requiredCapabilities": ["eventful"],
                  "surfaceClasses": ["workspace"],
                  "lifecycleStages": ["active"]
                },
                "source": {
                  "kind": "stream",
                  "ref": "stream:demo_metrics.events",
                  "scope": "shared",
                  "transport": "auto"
                }
              },
              {
                "id": "workspace_metric_chat",
                "kind": "chat_panel",
                "area": "bottom",
                "title": "Operator notes",
                "when": {
                  "requiredCapabilities": ["streamable"],
                  "surfaceClasses": ["workspace"],
                  "lifecycleStages": ["active"]
                },
                "source": {
                  "kind": "y",
                  "ref": "y:data/demo_metrics/chat",
                  "scope": "shared"
                },
                "config": {
                  "hint": "Workspace shell reuses the semantic demo surface.",
                  "alignRightFrom": "operator"
                }
              }
            ]
          }
        }
      }
    }
  }
}

{
	"$schema": "../../../../src/adaos/abi/webui.v1.schema.json",
	"apps": [
		{
			"id": "infrastate_app",
			"title": "Infra State",
  "icon": "server-outline",
			"launchModal": "infrastate_modal"
		}
	],
	"widgets": [
		{
			"id": "infrastate_widget",
			"title": "Infra State",
			"type": "visual.metricTile",
			"dataSource": {
				"kind": "y",
				"path": "data/infrastate/summary"
			},
			"actions": [
				{
					"on": "click:cancel_update",
					"type": "callHost",
					"target": "infrastate.action",
					"params": {
						"id": "$event.id"
					}
				}
			]
		}
	],
	"registry": {
		"modals": {
			"infrastate_modal": {
				"title": "Infrastructure State",
				"schema": {
					"id": "infrastate_modal",
					"layout": {
						"type": "single",
						"areas": [{ "id": "main", "role": "main" }]
					},
					"widgets": [
						{
							"id": "infrastate-summary",
							"type": "visual.metricTile",
							"area": "main",
							"title": "Current state",
							"dataSource": {
								"kind": "y",
								"path": "data/infrastate/summary"
							},
							"actions": [
								{
									"on": "click",
									"type": "callHost",
									"target": "infrastate.action",
									"params": {
										"id": "$event.id"
									}
								}
							]
						},
						{
							"id": "infrastate-nodes",
							"type": "input.commandBar",
							"area": "main",
							"title": "Nodes",
							"dataSource": {
								"kind": "y",
								"path": "data/infrastate/nodes"
							},
							"inputs": {
								"size": "small"
							},
							"actions": [
								{
									"on": "click",
									"type": "callHost",
									"target": "infrastate.action",
									"params": {
										"id": "select_node",
										"node_id": "$event.id"
									}
								}
							]
						},
						{
							"id": "infrastate-node-editor",
							"type": "input.text",
							"area": "main",
							"title": "Node names",
							"dataSource": {
								"kind": "y",
								"path": "data/infrastate/node_editor"
							},
							"inputs": {
								"bindField": "names_csv",
								"placeholder": "hub, alias"
							},
							"actions": [
								{
									"on": "change",
									"type": "callHost",
									"target": "infrastate.action",
									"params": {
										"id": "set_node_names",
										"value": "$event.value"
									}
								}
							]
						},
						{
							"id": "infrastate-actions",
							"type": "ui.actions",
							"area": "main",
							"title": "",
							"dataSource": {
								"kind": "y",
								"path": "data/infrastate/core_actions"
							},
							"inputs": {
								"size": "small"
							},
							"actions": [
								{
									"on": "click",
									"type": "callHost",
									"target": "infrastate.action",
									"params": {
										"id": "$event.id"
									}
								}
							]
						},
						{
							"id": "infrastate-yjs-actions",
							"type": "ui.actions",
							"area": "main",
							"title": "",
							"dataSource": {
								"kind": "y",
								"path": "data/infrastate/yjs_actions"
							},
							"inputs": {
								"size": "small"
							},
							"actions": [
								{
									"on": "click",
									"type": "callHost",
									"target": "infrastate.action",
									"params": {
										"id": "$event.id"
									}
								}
							]
						},
						{
							"id": "infrastate-build",
							"type": "ui.list",
							"area": "main",
							"title": "Build",
							"dataSource": {
								"kind": "y",
								"path": "data/infrastate/build"
							},
							"inputs": {
								"titleKey": "title",
								"subtitleKey": "description",
								"detailsPath": "",
								"showDetails": false,
								"itemAccordion": false,
								"emptyText": "No build metadata yet"
							}
						},
						{
							"id": "infrastate-steps",
							"type": "ui.list",
							"area": "main",
							"title": "Pipeline",
							"dataSource": {
								"kind": "y",
								"path": "data/infrastate/steps"
							},
							"inputs": {
								"titleKey": "title",
								"subtitleKey": "description",
								"showDetails": false,
								"itemAccordion": false,
								"emptyText": "No pipeline state yet"
							}
						},
						{
							"id": "infrastate-realtime",
							"type": "ui.list",
							"area": "main",
							"title": "Realtime channels",
							"dataSource": {
								"kind": "y",
								"path": "data/infrastate/realtime"
							},
							"inputs": {
								"titleKey": "title",
								"subtitleKey": "description",
								"detailsPath": "content",
								"showDetails": true,
								"itemAccordion": true,
								"emptyText": "No realtime diagnostics yet"
							}
						},
    {
      "id": "infrastate-slots",
      "type": "ui.list",
      "area": "main",
      "title": "Core slots",
      "dataSource": {
        "kind": "y",
        "path": "data/infrastate/slots"
      },
      "inputs": {
        "titleKey": "title",
        "subtitleKey": "subtitle",
        "detailsPath": "",
        "showDetails": false,
        "itemAccordion": false,
        "emptyText": "No slot manifests yet"
      }
    },
    {
      "id": "infrastate-update-actions",
      "type": "ui.actions",
      "area": "main",
      "title": "Update",
      "dataSource": {
        "kind": "y",
        "path": "data/infrastate/update_actions"
      },
      "inputs": {
        "size": "small"
      },
      "actions": [
        {
          "on": "click",
          "type": "callHost",
          "target": "infrastate.action",
          "params": {
            "id": "$event.id"
          }
        }
      ]
    },
    {
      "id": "infrastate-skills",
      "type": "ui.table",
      "area": "main",
      "title": "Installed skills",
							"dataSource": {
								"kind": "y",
								"path": "data/infrastate/skills"
							},
							"inputs": {
								"emptyText": "No installed skills",
								"columns": [
									{ "key": "name", "label": "Name" },
									{ "key": "version", "label": "Version", "mono": true, "width": "160px" },
									{ "key": "slot", "label": "Slot", "mono": true, "width": "90px" }
								],
								"buttons": [
									{ "id": "update", "label": "Update", "whenKey": "update_available", "whenEquals": true }
      ]
    },
							"actions": [
								{
									"on": "click:update",
									"type": "callHost",
									"target": "skills.update",
									"params": { "name": "$event.name" }
								}
							]
						},
						{
							"id": "infrastate-scenarios",
							"type": "ui.table",
							"area": "main",
							"title": "Installed scenarios",
							"dataSource": {
								"kind": "y",
								"path": "data/infrastate/scenarios"
							},
							"inputs": {
								"emptyText": "No installed scenarios",
								"columns": [
									{ "key": "name", "label": "Name" },
									{ "key": "version", "label": "Version", "mono": true, "width": "160px" }
								]
							}
						},
						{
							"id": "infrastate-logs",
							"type": "ui.list",
							"area": "main",
							"title": "Last logs",
							"dataSource": {
								"kind": "y",
								"path": "data/infrastate/logs"
							},
							"inputs": {
								"titleKey": "title",
								"subtitleKey": "preview",
								"detailsPath": "content",
								"showDetails": true,
								"itemAccordion": true,
								"emptyText": "No logs yet"
							}
						},
						{
							"id": "infrastate-events",
							"type": "ui.list",
							"area": "main",
							"title": "Event history",
							"dataSource": {
								"kind": "y",
								"path": "data/infrastate/events"
							},
							"inputs": {
								"titleKey": "type",
								"subtitleKey": "preview",
								"detailsPath": "payload",
								"showDetails": true,
								"itemAccordion": true,
								"emptyText": "No events yet"
							}
						}
					]
				}
			}
		},
		"widgets": {}
	},
	"ydoc_defaults": {
    "data/infrastate": {
      "summary": {
        "label": "Core update",
        "value": "idle",
        "subtitle": "slot —",
        "description": "No update in progress"
      },
      "update_actions": [
        {
          "id": "adaos_update",
          "title": "Update skills & scenarios",
          "status": "ok",
          "description": "Run workspace sync on the selected node"
        }
      ],
      "actions": [
        {
          "id": "refresh",
          "title": "Refresh snapshot",
          "description": "Reload current local update state"
        },
				{
					"id": "cancel_update",
					"title": "Cancel update",
					"description": "Cancel current countdown/update task"
				},
				{
					"id": "rollback",
					"title": "Rollback slot",
					"description": "Switch back to previous active core slot"
				},
				{
					"id": "drain",
					"title": "Drain node",
					"description": "Reject new tool calls and enter draining state"
				}
			],
			"core_actions": [
				{
					"id": "start_update",
					"title": "Start update",
					"description": "Schedule core update with current target rev"
				},
				{
					"id": "refresh",
					"title": "Refresh snapshot",
					"description": "Reload current local update state"
				},
				{
					"id": "cancel_update",
					"title": "Cancel update",
					"description": "Cancel current countdown/update task"
				},
				{
					"id": "rollback",
					"title": "Rollback slot",
					"description": "Switch back to previous active core slot"
				},
				{
					"id": "drain",
					"title": "Drain node",
					"description": "Reject new tool calls and enter draining state"
				}
			],
			"yjs_actions": [
				{
					"id": "yjs_backup",
					"title": "Yjs backup",
					"description": "Persist current in-memory Yjs state to disk snapshot"
				},
				{
					"id": "yjs_reload",
					"title": "Yjs reload",
					"description": "Reseed the selected webspace from its scenario source"
				},
				{
					"id": "yjs_reset",
					"title": "Yjs reset",
					"description": "Hard-reset the selected webspace from its scenario source"
				}
			],
			"nodes": [
				{
					"id": "local",
					"label": "hub"
				}
			],
			"yjs_webspaces": [
				{
					"id": "default",
					"label": "default *"
				}
			],
			"node_editor": {
				"names_csv": ""
			},
			"build": [],
			"steps": [],
			"realtime": [],
			"slots": [],
			"skills": [],
			"scenarios": [],
			"logs": []
			,
			"events": []
		}
	},
	"contributions": [
		{
			"extensionPoint": "desktop.apps",
			"type": "app",
			"id": "infrastate_app",
			"autoInstall": true
		},
		{
			"extensionPoint": "desktop.widgets",
			"type": "widget",
			"id": "infrastate_widget",
			"autoInstall": true
		}
	]
}

{
	"$schema": "../../../../src/adaos/abi/webui.v1.schema.json",
  "webio": {
    "receivers": {
      "infrastate.operations.active": { "mode": "replace", "initialState": [] },
      "infrastate.logs.recent": { "mode": "replace", "initialState": [] },
      "infrastate.events.recent": { "mode": "replace", "initialState": [] },
      "infrastate.yjs.load_mark": { "mode": "replace", "initialState": [] },
      "infrastate.build": { "mode": "replace", "initialState": [] },
      "infrastate.steps": { "mode": "replace", "initialState": [] },
      "infrastate.realtime": { "mode": "replace", "initialState": [] },
      "infrastate.slots": { "mode": "replace", "initialState": [] },
      "infrastate.skills": { "mode": "replace", "initialState": [] },
      "infrastate.scenarios": { "mode": "replace", "initialState": [] },
      "infrastate.marketplace.skills": { "mode": "replace", "initialState": [] },
      "infrastate.marketplace.scenarios": { "mode": "replace", "initialState": [] },
      "infrastate.core_update_diagnostics": { "mode": "replace", "initialState": [] }
    }
  },
	"apps": [
		{
			"id": "infrastate_app",
			"title": "Infra State",
  "icon": "server-outline",
			"launchModal": "infrastate_modal"
		}
	],
	"widgets": [
		{
			"id": "infrastate_widget",
			"title": "Infra State",
			"type": "visual.metricTile",
			"dataSource": {
				"kind": "y",
				"path": "data/infrastate/summary"
			},
			"actions": [
				{
					"on": "click:cancel_update",
					"type": "callHost",
					"target": "infrastate.action",
					"params": {
						"id": "$event.id"
					}
				}
			]
		}
	],
	"registry": {
		"modals": {
			"infrastate_modal": {
				"title": "Infrastructure State",
				"schema": {
					"id": "infrastate_modal",
					"layout": {
						"type": "single",
						"areas": [{ "id": "main", "role": "main" }]
					},
					"widgets": [
						{
							"id": "infrastate-summary",
							"type": "visual.metricTile",
							"area": "main",
							"title": "Current state",
							"dataSource": {
								"kind": "y",
								"path": "data/infrastate/summary"
							},
							"actions": [
								{
									"on": "click",
									"type": "callHost",
									"target": "infrastate.action",
									"params": {
										"id": "$event.id"
									}
								}
							]
						},
						{
							"id": "infrastate-nodes",
							"type": "input.commandBar",
							"area": "main",
							"title": "Nodes",
							"dataSource": {
								"kind": "y",
								"path": "data/infrastate/nodes"
							},
							"inputs": {
								"size": "small"
							},
							"actions": [
								{
									"on": "click",
									"type": "callHost",
									"target": "infrastate.action",
									"params": {
										"id": "select_node",
										"node_id": "$event.id"
									}
								}
							]
						},
						{
							"id": "infrastate-node-editor",
							"type": "input.text",
							"area": "main",
							"title": "Node names",
							"dataSource": {
								"kind": "y",
								"path": "data/infrastate/node_editor"
							},
							"inputs": {
								"bindField": "names_csv",
								"placeholder": "hub, alias"
							},
							"actions": [
								{
									"on": "change",
									"type": "callHost",
									"target": "infrastate.action",
									"params": {
										"id": "set_node_names",
										"value": "$event.value",
										"node_id": "$event.node_id",
										"target_node_id": "$event.target_node_id"
									}
								}
							]
						},
						{
							"id": "infrastate-actions",
							"type": "ui.actions",
							"area": "main",
							"title": "",
							"dataSource": {
								"kind": "y",
								"path": "data/infrastate/core_actions"
							},
							"inputs": {
								"size": "small"
							},
							"actions": [
								{
									"on": "click",
									"type": "callHost",
									"target": "infrastate.action",
									"params": {
										"id": "$event.id"
									}
								}
							]
						},
						{
							"id": "infrastate-yjs-actions",
							"type": "ui.actions",
							"area": "main",
							"title": "",
							"dataSource": {
								"kind": "y",
								"path": "data/infrastate/yjs_actions"
							},
							"inputs": {
								"size": "small"
							},
							"actions": [
								{
									"on": "click",
									"type": "callHost",
									"target": "infrastate.action",
									"params": {
										"id": "$event.id"
									}
								}
							]
						},
						{
							"id": "infrastate-build",
							"type": "ui.list",
							"area": "main",
							"title": "Build",
							"dataSource": {
								"kind": "stream",
								"receiver": "infrastate.build"
							},
							"inputs": {
								"titleKey": "title",
								"subtitleKey": "description",
								"detailsPath": "",
								"showDetails": false,
								"itemAccordion": false,
								"emptyText": "No build metadata yet"
							}
						},
						{
							"id": "infrastate-steps",
							"type": "ui.list",
							"area": "main",
							"title": "Pipeline",
							"dataSource": {
								"kind": "stream",
								"receiver": "infrastate.steps"
							},
							"inputs": {
								"titleKey": "title",
								"subtitleKey": "description",
								"showDetails": false,
								"itemAccordion": false,
								"emptyText": "No pipeline state yet"
							}
						},
						{
							"id": "infrastate-realtime",
							"type": "ui.list",
							"area": "main",
							"title": "Realtime channels",
							"dataSource": {
								"kind": "stream",
								"receiver": "infrastate.realtime"
							},
							"inputs": {
								"titleKey": "title",
								"subtitleKey": "description",
								"detailsPath": "content",
								"showDetails": true,
								"itemAccordion": true,
								"emptyText": "No realtime diagnostics yet"
							}
						},
    {
      "id": "infrastate-slots",
      "type": "ui.list",
      "area": "main",
      "title": "Core slots",
      "dataSource": {
        "kind": "stream",
        "receiver": "infrastate.slots"
      },
      "inputs": {
        "titleKey": "title",
        "subtitleKey": "subtitle",
        "detailsPath": "",
        "showDetails": false,
        "itemAccordion": false,
        "emptyText": "No slot manifests yet"
      }
    },
    {
      "id": "infrastate-update-actions",
      "type": "ui.actions",
      "area": "main",
      "title": "Update",
      "dataSource": {
        "kind": "y",
        "path": "data/infrastate/update_actions"
      },
      "inputs": {
        "size": "small"
      },
      "actions": [
        {
          "on": "click",
          "type": "callHost",
          "target": "infrastate.action",
          "params": {
            "id": "$event.id"
          }
        },
        {
          "on": "click:marketplace",
          "type": "openModal",
          "params": {
            "modalId": "marketplace_modal"
          }
        }
      ]
    },
    {
      "id": "infrastate-core-update-diag-actions",
      "type": "ui.actions",
      "area": "main",
      "title": "",
      "dataSource": {
        "kind": "y",
        "path": "data/infrastate/core_update_diag_actions"
      },
      "inputs": {
        "size": "small"
      },
      "actions": [
        {
          "on": "click",
          "type": "copyToClipboard",
          "params": {
            "text": "$event.text",
            "successMessage": "Diagnostics copied.",
            "errorMessage": "Copy failed."
          }
        }
      ]
    },
    {
      "id": "infrastate-core-update-diagnostics",
      "type": "ui.list",
      "area": "main",
      "title": "Core update diagnostics",
      "dataSource": {
        "kind": "stream",
        "receiver": "infrastate.core_update_diagnostics"
      },
      "inputs": {
        "titleKey": "title",
        "subtitleKey": "subtitle",
        "detailsPath": "content",
        "showDetails": true,
        "itemAccordion": true,
        "emptyText": "No core update diagnostics yet",
        "buttons": [
          { "id": "copy", "label": "Copy" }
        ]
      },
      "actions": [
        {
          "on": "click:copy",
          "type": "copyToClipboard",
          "params": {
            "text": "$event.copy_text",
            "successMessage": "Diagnostic copied.",
            "errorMessage": "Copy failed."
          }
        }
      ]
    },
    {
      "id": "infrastate-operations",
      "type": "ui.list",
      "area": "main",
      "title": "Active operations",
      "dataSource": {
        "kind": "stream",
        "receiver": "infrastate.operations.active"
      },
      "inputs": {
        "titleKey": "target_id",
        "subtitleKey": "message",
        "detailsPath": "",
        "showDetails": false,
        "itemAccordion": false,
        "emptyText": "No active operations"
      }
    },
    {
							"id": "infrastate-skills",
							"type": "ui.table",
							"area": "main",
							"title": "Installed skills",
							"dataSource": {
								"kind": "stream",
								"receiver": "infrastate.skills"
							},
							"inputs": {
								"emptyText": "No installed skills",
								"columns": [
									{ "key": "display_name", "label": "Name" },
									{ "key": "version_display", "label": "Version", "mono": true, "width": "160px" },
									{ "key": "slot", "label": "Slot", "mono": true, "width": "90px" }
								],
								"buttons": [
									{ "id": "activate", "label": "Activate" },
									{ "id": "test", "label": "Test" },
									{ "id": "update", "label": "Update", "whenKey": "update_available", "whenEquals": true },
									{ "id": "uninstall", "label": "Uninstall", "disabledKey": "uninstall_disabled" }
      ]
    },
							"actions": [
								{
									"on": "click:activate",
									"type": "callHost",
									"target": "infrastate.action",
									"params": { "id": "skill_activate", "name": "$event.name" }
								},
								{
									"on": "click:test",
									"type": "callHost",
									"target": "infrastate.action",
									"params": { "id": "skill_test", "name": "$event.name" }
								},
								{
									"on": "click:update",
									"type": "callHost",
									"target": "infrastate.action",
									"params": { "id": "skill_update", "name": "$event.name" }
								},
								{
									"on": "click:uninstall",
									"type": "callHost",
									"target": "infrastate.action",
									"params": { "id": "skill_uninstall", "name": "$event.name" }
								}
							]
						},
						{
							"id": "infrastate-scenarios",
							"type": "ui.table",
							"area": "main",
							"title": "Installed scenarios",
							"dataSource": {
								"kind": "stream",
								"receiver": "infrastate.scenarios"
							},
							"inputs": {
								"emptyText": "No installed scenarios",
								"columns": [
									{ "key": "name", "label": "Name" },
									{ "key": "version", "label": "Version", "mono": true, "width": "160px" }
								],
								"buttons": [
									{ "id": "uninstall", "label": "Uninstall", "disabledKey": "uninstall_disabled" }
								]
							},
							"actions": [
								{
									"on": "click:uninstall",
									"type": "callHost",
									"target": "infrastate.action",
									"params": { "id": "scenario_uninstall", "name": "$event.name" }
								}
							]
						},
						{
							"id": "infrastate-logs",
							"type": "ui.list",
							"area": "main",
							"title": "Last logs",
							"dataSource": {
								"kind": "stream",
								"receiver": "infrastate.logs.recent"
							},
							"inputs": {
								"titleKey": "title",
								"subtitleKey": "preview",
								"detailsPath": "content",
								"showDetails": true,
								"itemAccordion": true,
								"emptyText": "No logs yet"
							}
						},
						{
							"id": "infrastate-events",
							"type": "ui.list",
							"area": "main",
							"title": "Event history",
							"dataSource": {
								"kind": "stream",
								"receiver": "infrastate.events.recent"
							},
							"inputs": {
								"titleKey": "type",
								"subtitleKey": "preview",
								"detailsPath": "payload",
								"showDetails": true,
								"itemAccordion": true,
								"emptyText": "No events yet"
							}
						},
						{
							"id": "infrastate-yjs-load-mark",
							"type": "ui.table",
							"area": "main",
							"title": "Yjs load mark",
							"dataSource": {
								"kind": "stream",
								"receiver": "infrastate.yjs.load_mark"
							},
							"inputs": {
								"emptyText": "No recent Yjs flow",
								"columns": [
									{ "key": "kind", "label": "Kind", "width": "70px" },
									{ "key": "display", "label": "Owner / Root", "mono": true, "width": "180px" },
									{ "key": "status", "label": "State", "width": "90px" },
									{ "key": "avg_bps", "label": "Avg B/s", "mono": true, "width": "120px" },
									{ "key": "peak_bps", "label": "Peak B/s", "mono": true, "width": "120px" },
									{ "key": "avg_wps", "label": "Avg W/s", "mono": true, "width": "110px" },
									{ "key": "peak_wps", "label": "Peak W/s", "mono": true, "width": "110px" },
									{ "key": "recent_writes", "label": "Writes", "mono": true, "width": "90px" },
									{ "key": "current_size_bytes", "label": "Size", "mono": true, "width": "110px" }
								]
							}
						}
					]
				}
			},
			"marketplace_modal": {
				"title": "Marketplace",
				"schema": {
					"id": "marketplace_modal",
					"layout": {
						"type": "single",
						"areas": [{ "id": "main", "role": "main" }]
					},
					"widgets": [
						{
							"id": "marketplace-skills",
							"type": "ui.table",
							"area": "main",
							"title": "Installable skills",
							"dataSource": {
								"kind": "stream",
								"receiver": "infrastate.marketplace.skills"
							},
							"inputs": {
								"emptyText": "No installable skills",
								"columns": [
									{ "key": "id", "label": "Id", "mono": true, "width": "180px" },
									{ "key": "version", "label": "Version", "mono": true, "width": "110px" },
									{ "key": "description", "label": "Description" },
									{ "key": "operation_status", "label": "Status", "width": "120px" }
								],
								"buttons": [
									{ "id": "install", "label": "Install", "disabledKey": "install_disabled" }
								]
							},
							"actions": [
								{
									"on": "click:install",
									"type": "callHost",
									"target": "infrastate.action",
									"params": {
										"id": "marketplace_install",
										"value": "$event",
										"node_id": "$event.node_id",
										"target_node_id": "$event.target_node_id"
									}
								}
							]
						},
						{
							"id": "marketplace-scenarios",
							"type": "ui.table",
							"area": "main",
							"title": "Installable scenarios",
							"dataSource": {
								"kind": "stream",
								"receiver": "infrastate.marketplace.scenarios"
							},
							"inputs": {
								"emptyText": "No installable scenarios",
								"columns": [
									{ "key": "id", "label": "Id", "mono": true, "width": "180px" },
									{ "key": "version", "label": "Version", "mono": true, "width": "110px" },
									{ "key": "description", "label": "Description" },
									{ "key": "operation_status", "label": "Status", "width": "120px" }
								],
								"buttons": [
									{ "id": "install", "label": "Install", "disabledKey": "install_disabled" }
								]
							},
							"actions": [
								{
									"on": "click:install",
									"type": "callHost",
									"target": "infrastate.action",
									"params": {
										"id": "marketplace_install",
										"value": "$event",
										"node_id": "$event.node_id",
										"target_node_id": "$event.target_node_id"
									}
								}
							]
						},
						{
							"id": "marketplace-operations",
							"type": "ui.list",
							"area": "main",
							"title": "Active operations",
							"dataSource": {
								"kind": "stream",
								"receiver": "infrastate.operations.active"
							},
							"inputs": {
								"titleKey": "target_id",
								"subtitleKey": "message",
								"detailsPath": "",
								"showDetails": false,
								"itemAccordion": false,
								"emptyText": "No active operations"
							}
						}
					]
				}
			}
		},
		"widgets": {}
	},
	"ydoc_defaults": {
    "data/infrastate": {
      "summary": {
        "label": "Core update",
        "value": "idle",
        "subtitle": "slot —",
        "description": "No update in progress"
      },
      "update_actions": [
        {
          "id": "adaos_update",
          "title": "Update skills & scenarios",
          "status": "ok",
          "description": "Run workspace sync on the selected node"
        },
        {
          "id": "marketplace",
          "title": "Marketplace",
          "status": "ok",
          "description": "Browse registry catalog and install missing skills or scenarios"
        }
      ],
      "actions": [
        {
          "id": "refresh",
          "title": "Refresh snapshot",
          "description": "Reload current local update state"
        },
				{
					"id": "cancel_update",
					"title": "Cancel update",
					"description": "Cancel current countdown/update task"
				},
				{
					"id": "rollback",
					"title": "Rollback slot",
					"description": "Switch back to previous active core slot"
				},
				{
					"id": "drain",
					"title": "Drain node",
					"description": "Reject new tool calls and enter draining state"
				}
			],
			"core_actions": [
				{
					"id": "start_update",
					"title": "Start update",
					"description": "Schedule core update with current target rev"
				},
				{
					"id": "refresh",
					"title": "Refresh snapshot",
					"description": "Reload current local update state"
				},
				{
					"id": "cancel_update",
					"title": "Cancel update",
					"description": "Cancel current countdown/update task"
				},
				{
					"id": "rollback",
					"title": "Rollback slot",
					"description": "Switch back to previous active core slot"
				},
				{
					"id": "drain",
					"title": "Drain node",
					"description": "Reject new tool calls and enter draining state"
				}
			],
			"yjs_actions": [
				{
					"id": "yjs_backup",
					"title": "Yjs backup",
					"description": "Persist current in-memory Yjs state to disk snapshot"
				},
				{
					"id": "yjs_reload",
					"title": "Yjs reload",
					"description": "Reseed the selected webspace from its scenario source"
				},
				{
					"id": "yjs_reset",
					"title": "Yjs reset",
					"description": "Hard-reset the selected webspace from its scenario source"
				}
			],
			"nodes": [
				{
					"id": "local",
					"label": "hub"
				}
			],
			"yjs_webspaces": [
				{
					"id": "default",
					"label": "default *"
				}
			],
			"node_editor": {
				"names_csv": ""
			},
			"build": [],
			"steps": [],
			"realtime": [],
			"slots": [],
      "core_update_diagnostics": [],
      "core_update_diag_actions": [],
			"skills": [],
			"scenarios": [],
			"operations": { "items": [], "active": [] },
			"marketplace": { "skills": [], "scenarios": [] },
			"logs": []
			,
			"events": []
		}
	},
	"contributions": [
		{
			"extensionPoint": "desktop.apps",
			"type": "app",
			"id": "infrastate_app",
			"autoInstall": true
		},
		{
			"extensionPoint": "desktop.widgets",
			"type": "widget",
			"id": "infrastate_widget",
			"autoInstall": true
		}
	]
}

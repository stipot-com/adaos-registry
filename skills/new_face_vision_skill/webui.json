{
  "$schema": "../../../src/adaos/abi/webui.v1.schema.json",
  "apps": [
    {
      "id": "newface_vision_app",
      "title": "New Face Vision",
      "icon": "eye-outline",
      "launchModal": "newface_vision_modal"
    }
  ],
  "widgets": [
    {
      "id": "newface_vision_widget",
      "title": "New Face Vision",
      "type": "visual.metricTile",
      "dataSource": {
        "kind": "y",
        "path": "data/new_face_vision/current/latest"
      }
    }
  ],
  "registry": {
    "modals": {
      "newface_vision_modal": {
        "title": "New Face Vision",
        "schema": {
          "id": "newface_vision_modal",
          "layout": {
            "type": "single",
            "pattern": "stack",
            "areas": [
              {
                "id": "main",
                "role": "main"
              },
              {
                "id": "preview",
                "role": "detail"
              },
              {
                "id": "controls",
                "role": "footer"
              }
            ]
          },
          "widgets": [
            {
              "id": "newface_stats",
              "type": "ui.jsonViewer",
              "area": "main",
              "title": "Compact state",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/current"
              }
            },
            {
              "id": "newface_preview",
              "type": "ui.jsonViewer",
              "area": "preview",
              "title": "Frame stream",
              "dataSource": {
                "kind": "stream",
                "receiver": "newface_vision_frame"
              }
            },
            {
              "id": "newface_metrics",
              "type": "ui.jsonViewer",
              "area": "main",
              "title": "Metrics stream",
              "dataSource": {
                "kind": "stream",
                "receiver": "newface_vision_metrics"
              }
            },
            {
              "id": "newface_status",
              "type": "visual.metricTile",
              "area": "main",
              "title": "Latest result",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/current/latest"
              }
            },
            {
              "id": "newface_controls",
              "type": "input.commandBar",
              "area": "controls",
              "title": "Controls",
              "inputs": {
                "buttons": [
                  { "id": "play", "label": "Next frame", "icon": "play" },
                  { "id": "reset", "label": "Reset", "icon": "refresh" },
                  { "id": "clear", "label": "Clear", "icon": "trash", "kind": "danger" }
                ]
              },
              "actions": [
                {
                  "on": "click",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_action",
                  "params": {
                    "id": "$event.id"
                  }
                }
              ]
            }
          ]
        }
      }
    },
    "widgets": {}
  },
  "webio": {
    "receivers": {
      "newface_vision_frame": {
        "mode": "replace",
        "initialState": {}
      },
      "newface_vision_metrics": {
        "mode": "append",
        "collectionKey": "points",
        "dedupeBy": "frame_idx",
        "maxItems": 500,
        "initialState": {
          "points": []
        }
      },
      "newface_vision_progress": {
        "mode": "replace",
        "initialState": {}
      }
    }
  },
  "ydoc_defaults": {
    "data/new_face_vision/current": {
      "status": "init",
      "operation": {
        "id": null,
        "label": "",
        "progress": null,
        "error": null
      },
      "files": {
        "model": null,
        "frames": null,
        "masks": null,
        "metadata": null
      },
      "model": {
        "loaded": false,
        "path": null,
        "device": null
      },
      "stats": {
        "total_frames": 0,
        "loaded_masks": 0,
        "loaded_metadata": 0,
        "current_frame": null,
        "next_frame": 0,
        "model_loaded": false
      },
      "thresholds": {
        "warning": 0.05,
        "alarm": 0.15,
        "prediction": 0.35
      },
      "latest": {
        "value": "--",
        "label": "",
        "description": "",
        "frame_idx": null,
        "frame_key": null,
        "total_frames": 0,
        "pred_ratio": null,
        "true_ratio": null,
        "metrics": {
          "dice": 0,
          "iou": 0
        },
        "status": {
          "label": "",
          "color": ""
        },
        "ts": null
      },
      "error": null
    },
    "data/new_face_vision/history": []
  },
  "contributions": [
    {
      "extensionPoint": "desktop.widgets",
      "type": "widget",
      "id": "newface_vision_widget",
      "autoInstall": true
    }
  ]
}

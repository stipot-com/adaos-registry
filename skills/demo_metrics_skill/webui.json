{
  "$schema": "../../../../src/adaos/abi/webui.v1.schema.json",
  "webio": {
    "receivers": {
      "demo_metrics.events": {
        "mode": "append",
        "collectionKey": "items",
        "dedupeBy": "id",
        "maxItems": 50,
        "initialState": {
          "items": [
            {
              "id": "evt-0",
              "title": "Waiting for live updates",
              "description": "The event stream remains local to the current browser session."
            }
          ]
        }
      }
    }
  },
  "ydoc_defaults": {
    "data/demo_metrics/summary": {
      "value": "3",
      "label": "Demo metrics",
      "description": "Neutral semantic Web UI control task",
      "buttons": [
        { "id": "open-demo", "label": "Open modal" },
        { "id": "open-workspace", "label": "Workspace" },
        { "id": "open-operations", "label": "Operations" },
        { "id": "emit-skill", "label": "Skill event" },
        { "id": "emit-host", "label": "Host event" }
      ]
    },
    "data/demo_metrics/table": {
      "items": [
        {
          "id": "cpu",
          "title": "CPU Load",
          "status": "healthy",
          "value": 42,
          "unit": "%",
          "updated_at": "2026-05-07T10:00:00Z",
          "group": "compute"
        },
        {
          "id": "memory",
          "title": "Memory Pressure",
          "status": "warning",
          "value": 76,
          "unit": "%",
          "updated_at": "2026-05-07T10:00:00Z",
          "group": "compute"
        },
        {
          "id": "queue",
          "title": "Queue Depth",
          "status": "healthy",
          "value": 7,
          "unit": "jobs",
          "updated_at": "2026-05-07T10:00:00Z",
          "group": "runtime"
        }
      ]
    },
    "data/demo_metrics/chart": {
      "metric_id": "cpu",
      "title": "CPU Load",
      "x_key": "ts",
      "y_key": "value",
      "series_by_metric": {
        "cpu": {
          "metric_id": "cpu",
          "title": "CPU Load",
          "points": [
            { "ts": "10:00", "value": 31 },
            { "ts": "10:05", "value": 34 },
            { "ts": "10:10", "value": 39 },
            { "ts": "10:15", "value": 42 }
          ]
        },
        "memory": {
          "metric_id": "memory",
          "title": "Memory Pressure",
          "points": [
            { "ts": "10:00", "value": 62 },
            { "ts": "10:05", "value": 68 },
            { "ts": "10:10", "value": 74 },
            { "ts": "10:15", "value": 76 }
          ]
        },
        "queue": {
          "metric_id": "queue",
          "title": "Queue Depth",
          "points": [
            { "ts": "10:00", "value": 4 },
            { "ts": "10:05", "value": 6 },
            { "ts": "10:10", "value": 5 },
            { "ts": "10:15", "value": 7 }
          ]
        }
      },
      "points": [
        { "ts": "10:00", "value": 31 },
        { "ts": "10:05", "value": 34 },
        { "ts": "10:10", "value": 39 },
        { "ts": "10:15", "value": 42 }
      ]
    },
    "data/demo_metrics/chat": {
      "messages": [
        {
          "id": "chat-1",
          "from": "hub",
          "text": "Semantic chat_panel is now part of the demo surface.",
          "ts": "2026-05-07T10:00:00Z"
        },
        {
          "id": "chat-2",
          "from": "operator",
          "text": "The first rollout keeps chat read-only and shared-state backed.",
          "ts": "2026-05-07T10:01:00Z"
        }
      ]
    },
    "data/demo_metrics/selection": {
      "metric_id": "cpu",
      "status_filter": "all",
      "group_filter": "all"
    }
  },
  "apps": [
    {
      "id": "demo_metrics_app",
      "title": "Demo Metrics",
      "icon": "bar-chart-outline",
      "launchModal": "demo_metrics_modal"
    }
  ],
  "widgets": [
    {
      "id": "demo_metrics_summary",
      "type": "visual.metricTile",
      "title": "Demo Metrics",
      "dataSource": {
        "kind": "y",
        "path": "data/demo_metrics/summary"
      },
      "actions": [
        {
          "on": "click:open-demo",
          "type": "openModal",
          "params": { "modalId": "demo_metrics_modal" }
        },
        {
          "on": "click:open-workspace",
          "type": "openWorkspace",
          "params": {
            "modalId": "workspace_manager",
            "workspaceRef": "workspace:demo_metrics",
            "entityRef": "skill:demo_metrics_skill"
          }
        },
        {
          "on": "click:open-operations",
          "type": "openModal",
          "params": { "modalId": "demo_metrics_operations_modal" }
        },
        {
          "on": "click:emit-skill",
          "type": "callSkill",
          "target": "demo_metrics_skill.emit_demo_event",
          "params": {
            "action_id": "emit_skill_button",
            "metric_id": "$state.demo_metrics.selection.metric_id"
          }
        },
        {
          "on": "click:emit-host",
          "type": "callHost",
          "target": "demo_metrics.host_action",
          "params": {
            "action_id": "emit_host_button",
            "metric_id": "$state.demo_metrics.selection.metric_id"
          }
        }
      ]
    }
  ],
  "registry": {
    "modals": {
      "demo_metrics_modal": {
        "title": "Demo Metrics",
        "schema": {
          "id": "demo_metrics_modal",
          "layout": {
            "type": "split",
            "areas": [
              { "id": "main", "role": "main" },
              { "id": "right", "role": "aux" },
              { "id": "bottom", "role": "footer" }
            ]
          },
          "widgets": [
            {
              "id": "demo-metrics-table",
              "type": "ui.table",
              "area": "main",
              "title": "Metrics table",
              "dataSource": {
                "kind": "y",
                "path": "data/demo_metrics/table"
              },
              "inputs": {
                "columns": [
                  { "key": "title", "label": "Metric" },
                  { "key": "status", "label": "Status", "width": "120px" },
                  { "key": "value", "label": "Value", "width": "100px" },
                  { "key": "unit", "label": "Unit", "width": "90px" },
                  { "key": "updated_at", "label": "Updated", "width": "180px", "mono": true }
                ],
                "emptyText": "No demo metrics yet"
              }
            },
            {
              "id": "demo-metrics-actions",
              "type": "input.commandBar",
              "area": "right",
              "title": "Actions",
              "inputs": {
                "variant": "stack",
                "size": "small",
                "buttons": [
                  { "id": "emit-skill", "label": "Skill event" },
                  { "id": "emit-host", "label": "Host event" }
                ]
              },
              "actions": [
                {
                  "on": "click:emit-skill",
                  "type": "callSkill",
                  "target": "demo_metrics_skill.emit_demo_event",
                  "params": {
                    "action_id": "modal_skill_button",
                    "metric_id": "$state.demo_metrics.selection.metric_id"
                  }
                },
                {
                  "on": "click:emit-host",
                  "type": "callHost",
                  "target": "demo_metrics.host_action",
                  "params": {
                    "action_id": "modal_host_button",
                    "metric_id": "$state.demo_metrics.selection.metric_id"
                  }
                }
              ]
            },
            {
              "id": "demo-metrics-chart-payload",
              "type": "visual.metricChart",
              "area": "right",
              "title": "Metric trend",
              "dataSource": {
                "kind": "y",
                "path": "data/demo_metrics/chart"
              },
              "inputs": {
                "stateKey": "demo_metrics.selection",
                "xKey": "ts",
                "yKey": "value",
                "emptyText": "No chart payload yet"
              }
            },
            {
              "id": "demo-metrics-events",
              "type": "ui.list",
              "area": "bottom",
              "title": "Events",
              "dataSource": {
                "kind": "stream",
                "receiver": "demo_metrics.events"
              },
              "inputs": {
                "titleKey": "title",
                "subtitleKey": "description",
                "showDetails": false,
                "itemAccordion": false,
                "emptyText": "No live demo events yet"
              }
            },
            {
              "id": "demo-metrics-chat",
              "type": "ui.chat",
              "area": "bottom",
              "title": "Operator notes",
              "dataSource": {
                "kind": "y",
                "path": "data/demo_metrics/chat"
              },
              "inputs": {
                "hint": "Notes are seeded from shared demo state.",
                "alignRightFrom": "operator"
              }
            }
          ],
          "semantic": {
            "$schema": "../../../../src/adaos/abi/webui.semantic.v0.schema.json",
            "id": "demo_metrics_modal_semantic",
            "title": "Demo Metrics Semantic Surface",
            "workspace": {
              "surfaceClass": "workspace",
              "objectKind": "demo_metric_suite",
              "entityRef": "skill:demo_metrics_skill",
              "capabilities": [
                "inspectable",
                "listable",
                "streamable",
                "eventful"
              ],
              "lifecycleStage": "active"
            },
            "layout": {
              "pattern": "split",
              "areas": [
                { "id": "main", "role": "main" },
                { "id": "right", "role": "aux" },
                { "id": "bottom", "role": "footer" }
              ]
            },
            "viewState": [
              {
                "ref": "view:demo_metrics.selection",
                "default": {
                  "metric_id": "cpu",
                  "status_filter": "all",
                  "group_filter": "all"
                },
                "persistence": "local_persisted"
              }
            ],
            "views": [
              {
                "id": "metrics_grid",
                "kind": "collection_grid",
                "area": "main",
                "title": "Metrics table",
                "when": {
                  "requiredCapabilities": ["listable"],
                  "surfaceClasses": ["workspace"],
                  "lifecycleStages": ["active"]
                },
                "source": {
                  "kind": "y",
                  "ref": "y:data/demo_metrics/table",
                  "scope": "shared"
                },
                "selection": {
                  "kind": "view",
                  "ref": "view:demo_metrics.selection",
                  "scope": "local"
                },
                "config": {
                  "columns": [
                    { "key": "title", "label": "Metric" },
                    { "key": "status", "label": "Status" },
                    { "key": "value", "label": "Value" },
                    { "key": "unit", "label": "Unit" },
                    { "key": "updated_at", "label": "Updated" },
                    { "key": "group", "label": "Group" }
                  ]
                },
                "actions": [
                  {
                    "ref": "action:view.demo_metrics.select_metric",
                    "kind": "set_view_state",
                    "trigger": "select",
                    "payload": {
                      "metric_id": "$event.id"
                    }
                  }
                ]
              },
              {
                "id": "metrics_chart",
                "kind": "metric_chart",
                "area": "right",
                "title": "Metric trend",
                "when": {
                  "requiredCapabilities": ["inspectable"],
                  "surfaceClasses": ["workspace"],
                  "lifecycleStages": ["active"]
                },
                "source": {
                  "kind": "y",
                  "ref": "y:data/demo_metrics/chart",
                  "scope": "shared"
                },
                "selection": {
                  "kind": "view",
                  "ref": "view:demo_metrics.selection",
                  "scope": "local"
                },
                "config": {
                  "xKey": "ts",
                  "yKey": "value",
                  "seriesLabelKey": "title"
                }
              },
              {
                "id": "metrics_events",
                "kind": "event_log",
                "area": "bottom",
                "title": "Events",
                "when": {
                  "requiredCapabilities": ["eventful"],
                  "surfaceClasses": ["workspace"],
                  "lifecycleStages": ["active"]
                },
                "source": {
                  "kind": "stream",
                  "ref": "stream:demo_metrics.events",
                  "scope": "shared",
                  "transport": "auto"
                }
              },
              {
                "id": "metrics_chat",
                "kind": "chat_panel",
                "area": "bottom",
                "title": "Operator notes",
                "when": {
                  "requiredCapabilities": ["streamable"],
                  "surfaceClasses": ["workspace"],
                  "lifecycleStages": ["active"]
                },
                "source": {
                  "kind": "y",
                  "ref": "y:data/demo_metrics/chat",
                  "scope": "shared"
                },
                "config": {
                  "hint": "Notes are seeded from shared demo state.",
                  "alignRightFrom": "operator"
                }
              }
            ]
          }
        }
      },
      "demo_metrics_operations_modal": {
        "title": "Demo Operations",
        "schema": {
          "id": "demo_metrics_operations_modal",
          "layout": {
            "type": "split",
            "areas": [
              { "id": "main", "role": "main" },
              { "id": "right", "role": "aux" },
              { "id": "bottom", "role": "footer" }
            ]
          },
          "widgets": [
            {
              "id": "demo-operations-events",
              "type": "ui.list",
              "area": "main",
              "title": "Live events",
              "dataSource": {
                "kind": "stream",
                "receiver": "demo_metrics.events"
              },
              "inputs": {
                "titleKey": "title",
                "subtitleKey": "description",
                "showDetails": false,
                "itemAccordion": false,
                "emptyText": "No live demo events yet"
              }
            },
            {
              "id": "demo-operations-actions",
              "type": "input.commandBar",
              "area": "right",
              "title": "Actions",
              "inputs": {
                "variant": "stack",
                "size": "small",
                "buttons": [
                  { "id": "workspace", "label": "Workspace" },
                  { "id": "emit-skill", "label": "Skill event" },
                  { "id": "emit-host", "label": "Host event" }
                ]
              },
              "actions": [
                {
                  "on": "click:workspace",
                  "type": "openWorkspace",
                  "params": {
                    "modalId": "workspace_manager",
                    "workspaceRef": "workspace:demo_metrics",
                    "entityRef": "skill:demo_metrics_skill"
                  }
                },
                {
                  "on": "click:emit-skill",
                  "type": "callSkill",
                  "target": "demo_metrics_skill.emit_demo_event",
                  "params": {
                    "action_id": "operations_skill_button",
                    "metric_id": "$state.demo_metrics.selection.metric_id"
                  }
                },
                {
                  "on": "click:emit-host",
                  "type": "callHost",
                  "target": "demo_metrics.host_action",
                  "params": {
                    "action_id": "operations_host_button",
                    "metric_id": "$state.demo_metrics.selection.metric_id"
                  }
                }
              ]
            },
            {
              "id": "demo-operations-chart-payload",
              "type": "visual.metricChart",
              "area": "right",
              "title": "Selected metric",
              "dataSource": {
                "kind": "y",
                "path": "data/demo_metrics/chart"
              },
              "inputs": {
                "stateKey": "demo_metrics.selection",
                "xKey": "ts",
                "yKey": "value",
                "emptyText": "No chart payload yet"
              }
            },
            {
              "id": "demo-operations-chat",
              "type": "ui.chat",
              "area": "bottom",
              "title": "Operator notes",
              "dataSource": {
                "kind": "y",
                "path": "data/demo_metrics/chat"
              },
              "inputs": {
                "hint": "Operations surface keeps notes visible next to live state.",
                "alignRightFrom": "operator"
              }
            }
          ],
          "semantic": {
            "$schema": "../../../../src/adaos/abi/webui.semantic.v0.schema.json",
            "id": "demo_metrics_operations_semantic",
            "title": "Demo Operations Semantic Surface",
            "workspace": {
              "surfaceClass": "operations",
              "objectKind": "demo_metric_suite",
              "entityRef": "skill:demo_metrics_skill",
              "capabilities": [
                "inspectable",
                "streamable",
                "eventful"
              ],
              "lifecycleStage": "active"
            },
            "layout": {
              "pattern": "split",
              "areas": [
                { "id": "main", "role": "main" },
                { "id": "right", "role": "aux" },
                { "id": "bottom", "role": "footer" }
              ]
            },
            "viewState": [
              {
                "ref": "view:demo_metrics.selection",
                "default": {
                  "metric_id": "cpu",
                  "status_filter": "all",
                  "group_filter": "all"
                },
                "persistence": "local_persisted"
              }
            ],
            "views": [
              {
                "id": "operations_events",
                "kind": "event_log",
                "area": "main",
                "title": "Live events",
                "when": {
                  "requiredCapabilities": ["eventful"],
                  "surfaceClasses": ["operations"],
                  "lifecycleStages": ["active"]
                },
                "source": {
                  "kind": "stream",
                  "ref": "stream:demo_metrics.events",
                  "scope": "shared",
                  "transport": "auto"
                }
              },
              {
                "id": "operations_chart",
                "kind": "metric_chart",
                "area": "right",
                "title": "Selected metric",
                "when": {
                  "requiredCapabilities": ["inspectable"],
                  "surfaceClasses": ["operations"],
                  "lifecycleStages": ["active"]
                },
                "source": {
                  "kind": "y",
                  "ref": "y:data/demo_metrics/chart",
                  "scope": "shared"
                },
                "selection": {
                  "kind": "view",
                  "ref": "view:demo_metrics.selection",
                  "scope": "local"
                },
                "config": {
                  "xKey": "ts",
                  "yKey": "value",
                  "seriesLabelKey": "title"
                }
              },
              {
                "id": "operations_chat",
                "kind": "chat_panel",
                "area": "bottom",
                "title": "Operator notes",
                "when": {
                  "requiredCapabilities": ["streamable"],
                  "surfaceClasses": ["operations"],
                  "lifecycleStages": ["active"]
                },
                "source": {
                  "kind": "y",
                  "ref": "y:data/demo_metrics/chat",
                  "scope": "shared"
                },
                "config": {
                  "hint": "Operations surface keeps notes visible next to live state.",
                  "alignRightFrom": "operator"
                }
              },
              {
                "id": "workspace_only_grid_proof",
                "kind": "collection_grid",
                "area": "main",
                "title": "Workspace-only grid",
                "when": {
                  "requiredCapabilities": ["listable"],
                  "surfaceClasses": ["workspace"],
                  "lifecycleStages": ["active"]
                },
                "source": {
                  "kind": "y",
                  "ref": "y:data/demo_metrics/table",
                  "scope": "shared"
                },
                "selection": {
                  "kind": "view",
                  "ref": "view:demo_metrics.selection",
                  "scope": "local"
                },
                "config": {
                  "columns": [
                    { "key": "title", "label": "Metric" }
                  ]
                }
              }
            ]
          }
        }
      }
    }
  },
  "contributions": [
    {
      "extensionPoint": "desktop.apps",
      "type": "app",
      "id": "demo_metrics_app",
      "autoInstall": true
    },
    {
      "extensionPoint": "desktop.widgets",
      "type": "widget",
      "id": "demo_metrics_summary",
      "autoInstall": false
    }
  ]
}

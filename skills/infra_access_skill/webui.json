{
  "$schema": "../../../../src/adaos/abi/webui.v1.schema.json",
  "apps": [
    {
      "id": "infra_access_app",
      "title": "Infra Access",
      "icon": "shield-checkmark-outline",
      "launchModal": "infra_access_modal"
    }
  ],
  "widgets": [
    {
      "id": "infra_access_summary",
      "type": "visual.metricTile",
      "title": "Infra Access",
      "dataSource": {
        "kind": "y",
        "path": "data/infra_access/summary"
      }
    }
  ],
  "registry": {
    "modals": {
      "infra_access_modal": {
        "title": "Infra Access",
        "schema": {
          "id": "infra_access_modal",
          "layout": {
            "type": "single",
            "pattern": "stack",
            "areas": [
              {
                "id": "main",
                "role": "main"
              }
            ]
          },
          "widgets": [
            {
              "id": "infra-access-actions",
              "type": "input.commandBar",
              "area": "main",
              "title": "Actions",
              "inputs": {
                "buttons": [
                  {
                    "id": "refresh",
                    "label": "Refresh"
                  },
                  {
                    "id": "issue_session",
                    "label": "Issue MCP Session"
                  }
                ],
                "size": "small"
              },
              "actions": [
                {
                  "on": "click:refresh",
                  "type": "callHost",
                  "target": "infra_access.action",
                  "params": {
                    "id": "refresh"
                  }
                },
                {
                  "on": "click:issue_session",
                  "type": "callHost",
                  "target": "infra_access.action",
                  "params": {
                    "id": "issue_codex_session",
                    "capability_profile": "ProfileOpsRead",
                    "ttl_seconds": 28800
                  }
                }
              ]
            },
            {
              "id": "infra-access-summary",
              "type": "ui.list",
              "area": "main",
              "title": "Operational Summary",
              "dataSource": {
                "kind": "y",
                "path": "data/infra_access/summary_items"
              },
              "inputs": {
                "titleKey": "title",
                "subtitleKey": "description",
                "showDetails": false,
                "emptyText": "No infra_access state published yet"
              }
            },
            {
              "id": "infra-access-tokens",
              "type": "ui.list",
              "area": "main",
              "title": "Credentials and Sessions",
              "dataSource": {
                "kind": "y",
                "path": "data/infra_access/tokens"
              },
              "inputs": {
                "titleKey": "title",
                "subtitleKey": "description",
                "detailsPath": "content",
                "showDetails": true,
                "itemAccordion": true,
                "emptyText": "No issued tokens yet"
              }
            },
            {
              "id": "infra-access-codex-help",
              "type": "ui.list",
              "area": "main",
              "title": "VS Code Codex",
              "dataSource": {
                "kind": "y",
                "path": "data/infra_access/codex_help"
              },
              "inputs": {
                "titleKey": "title",
                "subtitleKey": "description",
                "detailsPath": "content",
                "showDetails": true,
                "itemAccordion": true,
                "emptyText": "Open MCP guidance will appear here"
              }
            },
            {
              "id": "infra-access-root-url",
              "type": "item.codeViewer",
              "area": "main",
              "title": "Root URL",
              "dataSource": {
                "kind": "y",
                "path": "data/infra_access/connection"
              },
              "inputs": {
                "bindField": "root_url",
                "languageField": "root_url_language",
                "copyButton": true
              }
            },
            {
              "id": "infra-access-mcp-url",
              "type": "item.codeViewer",
              "area": "main",
              "title": "MCP HTTP URL",
              "dataSource": {
                "kind": "y",
                "path": "data/infra_access/connection"
              },
              "inputs": {
                "bindField": "mcp_http_url",
                "languageField": "mcp_http_url_language",
                "copyButton": true
              }
            },
            {
              "id": "infra-access-codex-command",
              "type": "item.codeViewer",
              "area": "main",
              "title": "Codex Bootstrap Command",
              "dataSource": {
                "kind": "y",
                "path": "data/infra_access/connection"
              },
              "inputs": {
                "bindField": "codex_prepare_command",
                "languageField": "codex_prepare_language",
                "copyButton": true
              }
            },
            {
              "id": "infra-access-issued-session-id",
              "type": "item.codeViewer",
              "area": "main",
              "title": "Fresh Session ID",
              "dataSource": {
                "kind": "y",
                "path": "data/infra_access/issued_connection"
              },
              "inputs": {
                "bindField": "session_id",
                "languageField": "session_id_language",
                "copyButton": true
              }
            },
            {
              "id": "infra-access-issued-bearer",
              "type": "item.codeViewer",
              "area": "main",
              "title": "Fresh Bearer Token",
              "dataSource": {
                "kind": "y",
                "path": "data/infra_access/issued_connection"
              },
              "inputs": {
                "bindField": "access_token",
                "languageField": "access_token_language",
                "copyButton": true
              }
            },
            {
              "id": "infra-access-events",
              "type": "ui.list",
              "area": "main",
              "title": "Operational Events",
              "dataSource": {
                "kind": "y",
                "path": "data/infra_access/events"
              },
              "inputs": {
                "titleKey": "title",
                "subtitleKey": "description",
                "detailsPath": "content",
                "showDetails": true,
                "itemAccordion": true,
                "emptyText": "No infra_access events yet"
              }
            }
          ]
        }
      }
    }
  },
  "contributions": [
    {
      "extensionPoint": "desktop.apps",
      "type": "app",
      "id": "infra_access_app",
      "autoInstall": false
    }
  ]
}

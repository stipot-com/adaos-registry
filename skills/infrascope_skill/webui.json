{
  "$schema": "../../../../src/adaos/abi/webui.v1.schema.json",
  "webio": {
    "receivers": {
      "infrascope.overview.*": {
        "mode": "replace",
        "transport": "hub",
        "initialState": [],
        "budget": { "maxPayloadBytes": 32768, "maxPublishHz": 1, "maxSnapshotHz": 1, "maxItems": 128 },
        "guardVisibility": { "degradedState": "Keep last compact overview rows and open inspector details on demand.", "log": "service.infrascope_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.infrascope.overview" },
        "route": { "kind": "stream", "owner": "skill:infrascope_skill", "surface": "scenario:infrascope.overview" }
      },
      "infrascope.inventory.*": {
        "mode": "replace",
        "transport": "hub",
        "initialState": [],
        "budget": { "maxPayloadBytes": 65536, "maxPublishHz": 0.5, "maxSnapshotHz": 1, "maxItems": 256 },
        "guardVisibility": { "degradedState": "Keep last compact inventory rows; full object state stays in inspector streams.", "log": "service.infrascope_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.infrascope.inventory" },
        "route": { "kind": "stream", "owner": "skill:infrascope_skill", "surface": "scenario:infrascope.inventory" }
      },
      "infrascope.operations.active": {
        "mode": "replace",
        "transport": "hub",
        "initialState": [],
        "budget": { "maxPayloadBytes": 16384, "maxPublishHz": 1, "maxSnapshotHz": 1, "maxItems": 64 },
        "guardVisibility": { "degradedState": "Keep last active operation rows and surface stream guard pressure.", "log": "service.infrascope_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.infrascope.operations.active" },
        "route": { "kind": "stream", "owner": "skill:infrascope_skill", "surface": "scenario:infrascope.operations" }
      },
      "infrascope.inspector.*": {
        "mode": "replace",
        "transport": "hub",
        "initialState": {},
        "budget": { "maxPayloadBytes": 65536, "maxPublishHz": 1, "maxSnapshotHz": 1, "maxItems": 1 },
        "guardVisibility": { "degradedState": "Keep last selected-object inspector payload.", "log": "service.infrascope_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.infrascope.inspector" },
        "route": { "kind": "stream", "owner": "skill:infrascope_skill", "surface": "scenario:infrascope.inspector" }
      },
      "infrascope.inspector_field.*": {
        "mode": "replace",
        "transport": "hub",
        "initialState": {},
        "budget": { "maxPayloadBytes": 65536, "maxPublishHz": 1, "maxSnapshotHz": 1, "maxItems": 1 },
        "guardVisibility": { "degradedState": "Keep last selected inspector field and show stale state if rebuilding.", "log": "service.infrascope_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.infrascope.inspector_field" },
        "route": { "kind": "stream", "owner": "skill:infrascope_skill", "surface": "scenario:infrascope.inspector_field" }
      }
    }
  }
}
